(
    schema: "kithara.layout",
    version: 1,
    id: "gallery-menu",
    root: Split(
        axis: Vertical,
        children: [
            (weight: 1.0, node: Module(
                instance: "titlebar",
                source: "modules/titlebar.kmodule.ron",
                size: (w: Fill, h: Fixed(26.0)),
            )),
            (weight: 1.0, node: Split(
                axis: Horizontal,
                children: [
                    (weight: 1.0, node: Module(
                        instance: "gallery",
                        source: "modules/nav.kmodule.ron",
                        corners: true,
                        frame: (right: false),
                        size: (w: Fixed(198.0), h: Fill),
                    )),
                    (weight: 1.0, node: Split(
                        axis: Vertical,
                        children: [
                            (weight: 1.0, node: Module(
                                instance: "app-menu",
                                source: "modules/app-menu.kmodule.ron",
                                frame: (left: false, right: false, top: false),
                                size: (w: Fixed(340.0), h: Fixed(42.0)),
                            )),
                            (weight: 1.0, node: Module(
                                instance: "menu-notes",
                                source: "modules/tabs/menu-notes.kmodule.ron",
                                corners: true,
                                frame: (left: false, right: false, top: false),
                                size: (w: Fixed(340.0), h: Fill),
                            )),
                        ],
                    )),
                    (weight: 1.0, node: Module(
                        instance: "ctx",
                        source: "modules/tabs/menu-context.kmodule.ron",
                        corners: true,
                        frame: (left: false),
                        size: (w: Fill, h: Fill),
                    )),
                ],
            )),
        ],
    ),
)
