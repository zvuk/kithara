(
    schema: "kithara.layout",
    version: 1,
    id: "gallery-micro",
    root: Split(
        axis: Vertical,
        children: [
            (weight: 1.0, node: Module(
                instance: "titlebar",
                source: "modules/titlebar.kmodule.ron",
                size: (w: Fill, h: Fixed(26.0)),
            )),
            (weight: 1.0, node: Split(
                axis: Horizontal,
                children: [
                    (weight: 1.0, node: Module(
                        instance: "gallery",
                        source: "modules/nav.kmodule.ron",
                        corners: true,
                        frame: (right: false),
                        size: (w: Fixed(198.0), h: Fill),
                    )),
                    (weight: 1.0, node: Split(
                        axis: Vertical,
                        children: [
                            (weight: 1.0, node: Module(
                                instance: "micro-player",
                                source: "modules/deck-micro.kmodule.ron",
                                frame: (left: false, right: false, top: false, bottom: false),
                                with: { "deck": "a" },
                                size: (w: Fill, h: Fill),
                            )),
                            (weight: 1.0, node: Module(
                                instance: "micro-notes",
                                source: "modules/tabs/micro-notes.kmodule.ron",
                                corners: true,
                                frame: (left: false),
                                size: (w: Fill, h: Fixed(160.0)),
                            )),
                        ],
                    )),
                ],
            )),
        ],
    ),
)
