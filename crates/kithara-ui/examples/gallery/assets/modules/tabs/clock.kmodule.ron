(
    schema: "kithara.module",
    version: 1,
    id: "gallery-clock-components",
    root: Column(
        gap: 18.0,
        pad: 22.0,
        children: [
            Text(id: "title", style: Section, label: "DECK TIMING COMPONENTS", size: (w: Fill, h: Fixed(22.0))),
            Include(id: "overview", source: "../deck/overview-row.kmodule.ron", with: { "deck": "a", "letter": "A" }),
            Row(
                id: "controls",
                gap: 18.0,
                size: (w: Fill, h: Fixed(36.0)),
                children: [
                    Include(id: "key-lock", source: "../deck/key-lock.kmodule.ron", with: { "deck": "a" }),
                    Include(id: "master-clock", source: "../master-clock.kmodule.ron"),
                ],
            ),
            Text(id: "note", style: Body, color: TextDim, label: "MASTER CLOCK / SOURCE ROUTING / GRID / KEY LOCK / OVERVIEW", size: (w: Fill, h: Fixed(18.0))),
            Slot(id: "space", size: (w: Fill, h: Fill)),
        ],
    ),
)
