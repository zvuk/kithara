(
    schema: "kithara.module",
    version: 1,
    id: "gallery-motion-tab",
    root: Column(
        gap: Some(16.0),
        pad: Some(22.0),
        children: [
            Text(id: "title", style: Section, label: "MOTION", size: (w: Fill, h: Fixed(22.0))),
            Text(
                id: "note",
                style: Body,
                color: TextDim,
                label: "A MOTION SAYS HOW LONG, ALONG WHICH CURVE AND WHETHER IT REPEATS. ITS ENDPOINT HANDS OVER SECONDS, NOT A PHASE.",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Text(id: "turn-title", style: Section, label: "TURN", size: (w: Fill, h: Fixed(22.0))),
            Text(
                id: "turn-note",
                style: Body,
                color: TextDim,
                label: "WHICH WAY ROUND IS THE SIGN OF THE ROTATION. UP AND DOWN IS A TRACK THAT PING PONGS, NOT A SECOND KIND OF MOTION.",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Row(
                id: "turns",
                gap: Some(24.0),
                size: (w: Fill, h: Fixed(128.0)),
                children: [
                    Object(
                        id: "clockwise",
                        transform: (position: (0.0, 44.0), anchor: (60.0, 20.0)),
                        to: (position: (0.0, 44.0), anchor: (60.0, 20.0), rotation: 360.0),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 4.0, repeat: Loop),
                        child: Chip(id: "sunwise", label: "+360", size: (w: Fixed(120.0), h: Fixed(40.0))),
                    ),
                    Object(
                        id: "widdershins",
                        transform: (position: (0.0, 44.0), anchor: (60.0, 20.0)),
                        to: (position: (0.0, 44.0), anchor: (60.0, 20.0), rotation: -360.0),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 4.0, repeat: Loop),
                        child: Chip(id: "against", label: "-360", size: (w: Fixed(120.0), h: Fixed(40.0))),
                    ),
                    Object(
                        id: "bob",
                        to: (position: (0.0, 72.0)),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 4.0, repeat: PingPong, easing: InOut),
                        child: Chip(id: "bobbing", label: "UP DOWN", size: (w: Fixed(120.0), h: Fixed(40.0))),
                    ),
                    Slot(id: "turn-space", size: (w: Fill, h: Fill)),
                ],
            ),
            Text(id: "curve-title", style: Section, label: "CURVES", size: (w: Fill, h: Fixed(22.0))),
            Text(
                id: "curve-note",
                style: Body,
                color: TextDim,
                label: "ONE CLOCK, ONE DISTANCE, FOUR CURVES. EACH CHIP IS EXACTLY AS FAR ALONG AS ITS OWN CURVE PUTS IT.",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Row(
                id: "curves",
                gap: Some(24.0),
                size: (w: Fill, h: Fixed(48.0)),
                children: [
                    Object(
                        id: "even",
                        to: (position: (120.0, 0.0)),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 4.0, easing: Linear),
                        child: Chip(id: "linear", label: "LINEAR", size: (w: Fixed(96.0), h: Fixed(40.0))),
                    ),
                    Slot(id: "even-space", size: (w: Fixed(96.0), h: Fill)),
                    Object(
                        id: "leaves-slowly",
                        to: (position: (120.0, 0.0)),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 4.0, easing: In),
                        child: Chip(id: "ease-in", label: "IN", size: (w: Fixed(96.0), h: Fixed(40.0))),
                    ),
                    Slot(id: "in-space", size: (w: Fixed(96.0), h: Fill)),
                    Object(
                        id: "arrives-slowly",
                        to: (position: (120.0, 0.0)),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 4.0, easing: Out),
                        child: Chip(id: "ease-out", label: "OUT", size: (w: Fixed(96.0), h: Fixed(40.0))),
                    ),
                    Slot(id: "out-space", size: (w: Fixed(96.0), h: Fill)),
                    Object(
                        id: "slow-at-both-ends",
                        to: (position: (120.0, 0.0)),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 4.0, easing: InOut),
                        child: Chip(id: "ease-in-out", label: "IN OUT", size: (w: Fixed(96.0), h: Fixed(40.0))),
                    ),
                    Slot(id: "curve-space", size: (w: Fill, h: Fill)),
                ],
            ),
            Text(id: "repeat-title", style: Section, label: "REPEAT", size: (w: Fill, h: Fixed(22.0))),
            Text(
                id: "repeat-note",
                style: Body,
                color: TextDim,
                label: "ONE SECOND EACH, PHOTOGRAPHED AFTER ONE AND A HALF: ONCE HAS ARRIVED, LOOP HAS SET OFF AGAIN, PING PONG IS ON ITS WAY BACK.",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Row(
                id: "repeats",
                gap: Some(24.0),
                size: (w: Fill, h: Fixed(48.0)),
                children: [
                    Object(
                        id: "settles",
                        to: (position: (120.0, 0.0)),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 1.0, repeat: Once),
                        child: Chip(id: "once", label: "ONCE", size: (w: Fixed(96.0), h: Fixed(40.0))),
                    ),
                    Slot(id: "once-space", size: (w: Fixed(96.0), h: Fill)),
                    Object(
                        id: "begins-again",
                        to: (position: (120.0, 0.0)),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 1.0, repeat: Loop),
                        child: Chip(id: "loop", label: "LOOP", size: (w: Fixed(96.0), h: Fixed(40.0))),
                    ),
                    Slot(id: "loop-space", size: (w: Fixed(96.0), h: Fill)),
                    Object(
                        id: "walks-home",
                        to: (position: (120.0, 0.0)),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 1.0, repeat: PingPong),
                        child: Chip(id: "ping-pong", label: "PING PONG", size: (w: Fixed(96.0), h: Fixed(40.0))),
                    ),
                    Slot(id: "repeat-space", size: (w: Fill, h: Fill)),
                ],
            ),
            Text(
                id: "cost",
                style: Body,
                color: TextDim,
                label: "A MOTION THAT REPEATS NEVER SETTLES, WHICH IS WHY THE DOCUMENT SAYS SO: A PAGE DECLARING ONE NEVER SLEEPS.",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Slot(id: "space", size: (w: Fill, h: Fill)),
        ],
    ),
)
