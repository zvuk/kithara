(
    schema: "kithara.module",
    version: 1,
    id: "gallery-sprites-tab",
    root: Column(
        gap: Some(16.0),
        pad: Some(22.0),
        children: [
            Text(id: "title", style: Section, label: "SPRITES", size: (w: Fill, h: Fixed(22.0))),
            Text(
                id: "note",
                style: Body,
                color: TextDim,
                label: "A SHEET IS CUT INTO FRAMES ONCE, WHEN IT IS READ. EACH FRAME IS ITS OWN PICTURE, SO A DRAWING ASKS FOR ONE BY INDEX AND NO SOURCE RECTANGLE CROSSES THE SEAM.",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Text(id: "sheet-title", style: Section, label: "THE SHEET", size: (w: Fill, h: Fixed(22.0))),
            Text(
                id: "sheet-note",
                style: Body,
                color: TextDim,
                label: "EIGHT SPRITES OVER ONE SHEET, EACH HELD AT ITS OWN SECOND OF AN EIGHT SECOND PASS.",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Row(
                id: "sheet",
                gap: Some(12.0),
                size: (w: Fill, h: Fixed(64.0)),
                children: [
                    Sprite(id: "f0", sheet: "spinner", seconds: 8.0, read: Model(id: "gallery.sprite.frame.0"), size: (w: Fixed(64.0), h: Fixed(64.0))),
                    Sprite(id: "f1", sheet: "spinner", seconds: 8.0, read: Model(id: "gallery.sprite.frame.1"), size: (w: Fixed(64.0), h: Fixed(64.0))),
                    Sprite(id: "f2", sheet: "spinner", seconds: 8.0, read: Model(id: "gallery.sprite.frame.2"), size: (w: Fixed(64.0), h: Fixed(64.0))),
                    Sprite(id: "f3", sheet: "spinner", seconds: 8.0, read: Model(id: "gallery.sprite.frame.3"), size: (w: Fixed(64.0), h: Fixed(64.0))),
                    Sprite(id: "f4", sheet: "spinner", seconds: 8.0, read: Model(id: "gallery.sprite.frame.4"), size: (w: Fixed(64.0), h: Fixed(64.0))),
                    Sprite(id: "f5", sheet: "spinner", seconds: 8.0, read: Model(id: "gallery.sprite.frame.5"), size: (w: Fixed(64.0), h: Fixed(64.0))),
                    Sprite(id: "f6", sheet: "spinner", seconds: 8.0, read: Model(id: "gallery.sprite.frame.6"), size: (w: Fixed(64.0), h: Fixed(64.0))),
                    Sprite(id: "f7", sheet: "spinner", seconds: 8.0, read: Model(id: "gallery.sprite.frame.7"), size: (w: Fixed(64.0), h: Fixed(64.0))),
                    Slot(id: "sheet-space", size: (w: Fill, h: Fill)),
                ],
            ),
            Text(id: "played-title", style: Section, label: "PLAYED AND SCRUBBED", size: (w: Fill, h: Fixed(22.0))),
            Text(
                id: "played-note",
                style: Body,
                color: TextDim,
                label: "ONE CONTROL, TWO BINDINGS. THE LEFT ONE READS THE HOST'S OWN CLOCK, WHICH NO APPLICATION DECLARES; THE RIGHT ONE READS THE FADER BESIDE IT.",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Row(
                id: "played",
                gap: Some(24.0),
                size: (w: Fill, h: Fixed(96.0)),
                children: [
                    Sprite(id: "clockwork", sheet: "spinner", seconds: 1.6, read: Model(id: "ui.clock.seconds"), size: (w: Fixed(96.0), h: Fixed(96.0))),
                    Sprite(id: "scrubbed", sheet: "spinner", seconds: 1.0, read: Model(id: "gallery.sprite.scrub"), size: (w: Fixed(96.0), h: Fixed(96.0))),
                    Column(
                        id: "scrub-column",
                        gap: Some(8.0),
                        size: (w: Fixed(240.0), h: Fill),
                        children: [
                            Slot(id: "scrub-top", size: (w: Fill, h: Fill)),
                            Fader(
                                id: "scrub",
                                style: Default,
                                label: "SCRUB",
                                read: Model(id: "gallery.sprite.scrub"),
                                write: Parameter(id: "gallery.sprite.scrub"),
                                size: (w: Fill, h: Fixed(34.0)),
                            ),
                            Slot(id: "scrub-bottom", size: (w: Fill, h: Fill)),
                        ],
                    ),
                    Slot(id: "played-space", size: (w: Fill, h: Fill)),
                ],
            ),
            Text(id: "posed-title", style: Section, label: "POSED", size: (w: Fill, h: Fixed(22.0))),
            Text(
                id: "posed-note",
                style: Body,
                color: TextDim,
                label: "A SPRITE IS A CONTROL LIKE ANY OTHER, SO AN OBJECT TURNS ONE WITHOUT THE SHEET KNOWING. THE FRAME AND THE POSE RUN OFF THEIR OWN CLOCKS.",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Stage(
                id: "posed",
                size: (w: Fill, h: Fixed(112.0)),
                children: [
                    Object(
                        id: "turning",
                        transform: (anchor: (48.0, 48.0)),
                        to: (anchor: (48.0, 48.0), rotation: 360.0),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 6.0, repeat: Loop),
                        child: Sprite(id: "carried", sheet: "spinner", seconds: 1.6, read: Model(id: "ui.clock.seconds"), size: (w: Fixed(96.0), h: Fixed(96.0))),
                    ),
                    Object(
                        id: "travelling",
                        transform: (position: (144.0, 8.0)),
                        to: (position: (384.0, 8.0)),
                        motion: (clock: Model(id: "gallery.motion.clock"), duration: 5.0, repeat: PingPong, easing: InOut),
                        child: Sprite(id: "flying", sheet: "spinner", seconds: 0.8, read: Model(id: "ui.clock.seconds"), size: (w: Fixed(80.0), h: Fixed(80.0))),
                    ),
                ],
            ),
            Text(
                id: "limit",
                style: Body,
                color: TextDim,
                label: "A SHEET THE TOOLKIT DOES NOT SHIP DRAWS NOTHING, WHICH IS WHAT AN UNBOUND CONTROL DOES EVERYWHERE ELSE.",
                size: (w: Fill, h: Fixed(18.0)),
            ),
            Slot(id: "space", size: (w: Fill, h: Fill)),
        ],
    ),
)
