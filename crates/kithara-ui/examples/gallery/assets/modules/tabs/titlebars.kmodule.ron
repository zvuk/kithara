(
    schema: "kithara.module",
    version: 1,
    id: "gallery-titlebars-tab",
    root: Column(
        gap: Some(14.0),
        pad: Some(24.0),
        children: [
            Text(
                id: "full-label",
                style: Section,
                label: "FULL WINDOW TITLE BAR",
            ),
            Row(
                gap: Some(0.0),
                size: (w: Fill, h: Fixed(26.0)),
                children: [
                    TitleBar(
                        id: "full-title",
                        label: "KITHARA / LIBRARY",
                        size: (w: Fill, h: Fixed(26.0)),
                    ),
                    WindowControls(id: "full-controls", style: Standard),
                ],
            ),
            Text(
                id: "standard-label",
                style: Section,
                label: "GLOBAL BAR / 2 DECKS",
            ),
            WindowControls(id: "standard", style: Standard),
            Text(
                id: "compact-label",
                style: Section,
                label: "TOP BAR / 1 OR 4 DECKS / TABS",
            ),
            WindowControls(id: "compact", style: Compact),
            Text(
                id: "wide-label",
                style: Section,
                label: "SETTINGS MODAL",
            ),
            WindowControls(id: "close-wide", style: CloseWide),
            Text(
                id: "micro-label",
                style: Section,
                label: "MICRO",
            ),
            WindowControls(id: "close-micro", style: CloseMicro),
            Text(
                id: "framed-label",
                style: Section,
                label: "VIEW SETTINGS",
            ),
            WindowControls(id: "close-framed", style: CloseFramed),
        ],
    ),
)
