(
    schema: "kithara.module",
    version: 1,
    id: "gallery-menu-context",
    root: Column(
        gap: 14.0,
        pad: 14.0,
        children: [
            Text(id: "title", style: Section, label: "CONTEXT MENU"),
            Text(
                id: "hint",
                style: MicroLabel,
                label: "RIGHT-CLICK A TRACK TO OPEN ITS MENU. LEFT-CLICK SELECTS. PRESS OUTSIDE OR ESC TO DISMISS.",
                size: (w: Fill, h: Fixed(38.0)),
            ),
            Column(
                id: "list",
                gap: 0.0,
                frame: (top: true, right: true, bottom: false, left: true),
                children: [
                    Popover(
                        id: "track-1-menu",
                        open: Model(id: "gallery.menu.context", with: { "row": "1" }),
                        at: Pointer,
                        anchor: Pressable(
                            id: "track-1",
                            press: Command(id: "gallery.menu.select", with: { "row": "1" }),
                            child: Row(
                                size: (w: Fill, h: Fixed(30.0)),
                                pad_x: 10.0,
                                gap: 8.0,
                                frame: (top: false, right: false, bottom: true, left: false),
