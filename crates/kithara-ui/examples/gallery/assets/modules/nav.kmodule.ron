(
    schema: "kithara.module",
    version: 1,
    id: "gallery-nav",
    root: Column(
        children: [
            Row(
                size: (w: Fill, h: Shrink),
                gap: Some(8.0),
                pad: Some(10.0),
                children: [
                    Glyph(
                        id: "header-icon",
                        icon: Gear,
                        size: (w: Fixed(20.0), h: Fixed(20.0)),
                    ),
                    Text(
                        id: "header-title",
                        style: TrackTitle,
                        label: "GALLERY",
                        size: (w: Fill, h: Fixed(20.0)),
                    ),
                ],
            ),
            Include(id: "atoms", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "PRIMITIVES", "tab": "gallery.tab.atoms" }),
            Include(id: "buttons", source: "nav/item.kmodule.ron", with: { "icon": "Play", "label": "BUTTONS", "tab": "gallery.tab.buttons" }),
            Include(id: "faders", source: "nav/item.kmodule.ron", with: { "icon": "Faders", "label": "FADERS", "tab": "gallery.tab.faders" }),
            Include(id: "modules", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "MODULES", "tab": "gallery.tab.modules" }),
            Include(id: "typography", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "TYPOGRAPHY", "tab": "gallery.tab.typography" }),
            Include(id: "cells", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "CELLS", "tab": "gallery.tab.cells" }),
            Include(id: "sizes", source: "nav/item.kmodule.ron", with: { "icon": "Faders", "label": "SIZES", "tab": "gallery.tab.sizes" }),
            Include(id: "tokens", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "TOKENS", "tab": "gallery.tab.tokens" }),
            Include(id: "micro", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "MICRO", "tab": "gallery.tab.micro" }),
            Include(id: "mixer", source: "nav/item.kmodule.ron", with: { "icon": "Faders", "label": "MIXER", "tab": "gallery.tab.mixer" }),
            Include(id: "vis", source: "nav/item.kmodule.ron", with: { "icon": "Waveform", "label": "VIS", "tab": "gallery.tab.vis" }),
            Include(id: "chrome", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "CHROME", "tab": "gallery.tab.chrome" }),
            Include(id: "titlebars", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "TITLE BARS", "tab": "gallery.tab.titlebars" }),
            Include(id: "tracklist", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "TRACKLIST", "tab": "gallery.tab.tracklist" }),
            Include(id: "tree", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "TREE", "tab": "gallery.tab.tree" }),
            Include(id: "library2", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "LIBRARY V2", "tab": "gallery.tab.library2" }),
            Include(id: "stress", source: "nav/item.kmodule.ron", with: { "icon": "SpeakerHigh", "label": "STRESS", "tab": "gallery.tab.stress" }),
            Include(id: "menu", source: "nav/item.kmodule.ron", with: { "icon": "Menu", "label": "MENU", "tab": "gallery.tab.menu" }),
        ],
    ),
)
