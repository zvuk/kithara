(
    schema: "kithara.module",
    version: 1,
    id: "master-clock-source-row",
    chrome: Plain,
    parameters: ["source"],
    root: Row(
        size: (w: Fill, h: Fixed(24.0)),
        gap: 7.0,
        pad_x: 11.0,
        frame: (top: false, right: false, bottom: true, left: false),
        frame_color: LinePop,
        active: Model(id: "clock.source.active", with: { "source": "$source" }),
        active_background: BgSelect,
        children: [
            Button(
                id: "select",
                label: "",
                icon: Some(Crown),
                style: Transport,
                read: Model(id: "clock.source.active", with: { "source": "$source" }),
                write: Command(id: "clock.source.select", with: { "source": "$source" }),
                size: (w: Fixed(14.0), h: Fixed(18.0)),
            ),
            Text(
                id: "name",
                style: Mono,
                color: TextDim,
                active_color: Accent,
                active: Model(id: "clock.source.active", with: { "source": "$source" }),
                read: Model(id: "clock.source.name", with: { "source": "$source" }),
                size: (w: Fixed(34.0), h: Fill),
            ),
            Text(
                id: "tempo",
                style: Mono,
                color: TextDim,
                active_color: Text,
                active: Model(id: "clock.source.active", with: { "source": "$source" }),
                read: Model(id: "clock.source.tempo", with: { "source": "$source" }),
                size: (w: Fixed(50.0), h: Fill),
            ),
            Text(
                id: "mode",
                style: MicroLabel,
                read: Model(id: "clock.source.mode", with: { "source": "$source" }),
                size: (w: Fixed(72.0), h: Fill),
            ),
            Text(
                id: "pulse",
                style: Mono,
                align: End,
                read: Model(id: "clock.source.pulse", with: { "source": "$source" }),
                size: (w: Fixed(46.0), h: Fill),
            ),
            Text(
                id: "stretch",
                style: Mono,
                align: End,
                read: Model(id: "clock.source.stretch", with: { "source": "$source" }),
                size: (w: Fill, h: Fill),
            ),
            Glyph(
                id: "mode-icon",
                icon: LockOpen,
                active_icon: Some(Lock),
                style: MenuCell,
                color: Muted,
                active_color: Accent,
                active: Model(id: "clock.source.synced", with: { "source": "$source" }),
                size: (w: Fixed(26.0), h: Fill),
            ),
        ],
    ),
)
