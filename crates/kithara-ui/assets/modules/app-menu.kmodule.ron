(
    schema: "kithara.module",
    version: 1,
    id: "app-menu",
    chrome: Plain,
    root: Row(
        id: "menu",
        size: (w: Shrink, h: Fill),
        gap: 0.0,
        children: [
            Popover(
                id: "pop",
                open: Model(id: "ui.menu.open"),
                anchor: Pressable(
                    id: "burger",
                    press: Command(id: "ui.menu.toggle"),
                    child: Row(
                        size: (w: Fixed(36.0), h: Fill),
                        gap: 0.0,
                        frame: (top: false, right: true, bottom: false, left: false),
                        frame_color: LineInner,
                        active: Model(id: "ui.menu.open"),
                        active_background: BgSelect,
                        children: [
                            Row(size: (w: Fill, h: Fill), gap: 0.0, children: []),
                            Glyph(id: "burger-icon", icon: Menu, style: MenuBurger, color: TextDim),
                            Row(size: (w: Fill, h: Fill), gap: 0.0, children: []),
                        ],
                    ),
                ),
                content: Column(
                    id: "surface",
                    size: (w: Fixed(298.0), h: Shrink),
                    gap: 0.0,
                    children: [
                        Row(
                            id: "header",
                            size: (w: Fill, h: Fixed(26.0)),
                            pad_x: 10.0,
                            gap: 8.0,
                            frame: (top: false, right: false, bottom: true, left: false),
                            frame_color: LinePop,
                            children: [
                                Text(
                                    id: "brand",
                                    size: (w: Fill, h: Fill),
                                    style: BrandSmall,
                                    label: "KITHARA",
                                ),
                                Text(id: "version", style: MicroLabel, label: "2.4.1"),
                                Pressable(
                                    id: "header-close",
                                    press: Command(id: "ui.menu.close"),
                                    child: Glyph(
                                        id: "header-close-icon",
                                        icon: X,
                                        style: MenuSmall,
                                        color: Muted,
                                    ),
                                ),
                            ],
                        ),
                        Row(
                            id: "windows-head",
                            size: (w: Fill, h: Fixed(22.0)),
                            pad_x: 10.0,
                            gap: 0.0,
                            frame: (top: false, right: false, bottom: true, left: false),
                            frame_color: LinePop,
                            children: [
                                Text(
                                    id: "windows-head-label",
                                    size: (w: Fill, h: Fill),
                                    style: MicroLabel,
                                    label: "ОКНА И МОДУЛИ",
                                ),
                                Text(
                                    id: "windows-head-count",
                                    style: MicroLabel,
                                    read: Model(id: "ui.window.count"),
                                ),
                            ],
                        ),
                        Include(id: "window-1", source: "app-menu/window-row.kmodule.ron", with: { "window": "1" }),
                        Optional(
                            id: "window-2-block",
                            hidden: Model(id: "ui.window.hidden", with: { "window": "2" }),
                            child: Include(id: "window-2", source: "app-menu/window-row.kmodule.ron", with: { "window": "2" }),
                        ),
                        Optional(
                            id: "window-3-block",
                            hidden: Model(id: "ui.window.hidden", with: { "window": "3" }),
                            child: Include(id: "window-3", source: "app-menu/window-row.kmodule.ron", with: { "window": "3" }),
                        ),
                        Pressable(
                            id: "new-window",
                            press: Command(id: "ui.window.open"),
                            child: Row(
                                size: (w: Fill, h: Fixed(26.0)),
                                pad_x: 10.0,
                                gap: 8.0,
                                frame: (top: true, right: false, bottom: false, left: false),
                                frame_color: LinePop,
                                children: [
                                    Glyph(
                                        id: "new-window-icon",
                                        icon: Plus,
                                        style: Menu,
                                        color: Muted,
                                        active_color: Accent,
                                        active: Model(id: "ui.window.can_open"),
                                    ),
                                    Text(
                                        id: "new-window-label",
                                        size: (w: Fill, h: Fill),
                                        style: Mono,
                                        color: Muted,
                                        active_color: Accent,
                                        label: "Новое окно",
                                        active: Model(id: "ui.window.can_open"),
                                    ),
                                ],
                            ),
                        ),
                        Pressable(
                            id: "modules-head",
                            press: Command(id: "ui.menu.toggle_group", with: { "group": "mod" }),
                            child: Row(
                                size: (w: Fill, h: Fixed(26.0)),
                                pad_x: 10.0,
                                gap: 8.0,
                                frame: (top: true, right: false, bottom: false, left: false),
                                frame_color: LinePop,
                                children: [
                                    Glyph(
                                        id: "modules-caret",
                                        icon: ChevronRight,
                                        active_icon: ChevronDown,
                                        style: Menu,
                                        color: Muted,
                                        active: Model(id: "ui.menu.group_open", with: { "group": "mod" }),
                                    ),
                                    Text(
                                        id: "modules-title",
                                        size: (w: Fill, h: Fill),
                                        style: Mono,
                                        color: Text,
                                        read: Model(id: "ui.modules.title"),
                                    ),
                                    Text(
                                        id: "modules-count",
                                        style: MicroLabel,
                                        read: Model(id: "ui.modules.count"),
                                    ),
                                ],
                            ),
                        ),
                        Optional(
                            id: "modules-block",
                            hidden: Model(id: "ui.menu.group_hidden", with: { "group": "mod" }),
                            child: Row(
                                id: "modules-grid",
                                size: (w: Fill, h: Shrink),
                                pad_x: 10.0,
                                gap: 0.0,
                                children: [
                                    Row(id: "modules-indent", size: (w: Fixed(17.0), h: Fill), gap: 0.0, children: []),
                                    Column(
                                        id: "modules-column",
                                        size: (w: Fill, h: Shrink),
                                        gap: 4.0,
                                        children: [
                                            Row(
                                                id: "modules-row-1",
                                                size: (w: Fill, h: Fixed(20.0)),
                                                gap: 4.0,
                                                children: [
                                                    Include(id: "module-ov", source: "app-menu/module-cell.kmodule.ron", with: { "label": "OVERVIEW", "module": "ov" }),
                                                    Include(id: "module-mix", source: "app-menu/module-cell.kmodule.ron", with: { "label": "MIXER", "module": "mix" }),
                                                    Include(id: "module-fx1", source: "app-menu/module-cell.kmodule.ron", with: { "label": "FX 1", "module": "fx1" }),
                                                ],
                                            ),
                                            Row(
                                                id: "modules-row-2",
                                                size: (w: Fill, h: Fixed(20.0)),
                                                gap: 4.0,
                                                children: [
                                                    Include(id: "module-fx2", source: "app-menu/module-cell.kmodule.ron", with: { "label": "FX 2", "module": "fx2" }),
                                                    Include(id: "module-vcf", source: "app-menu/module-cell.kmodule.ron", with: { "label": "VCF", "module": "vcf" }),
                                                    Include(id: "module-rec", source: "app-menu/module-cell.kmodule.ron", with: { "label": "REC", "module": "rec" }),
                                                ],
                                            ),
                                            Row(
                                                id: "modules-row-3",
                                                size: (w: Fill, h: Fixed(20.0)),
                                                gap: 4.0,
                                                children: [
                                                    Include(id: "module-vis", source: "app-menu/module-cell.kmodule.ron", with: { "label": "VISUAL", "module": "vis" }),
                                                    Include(id: "module-tl", source: "app-menu/module-cell.kmodule.ron", with: { "label": "TIMELINE", "module": "tl" }),
                                                    Include(id: "module-cpu", source: "app-menu/module-cell.kmodule.ron", with: { "label": "CPU", "module": "cpu" }),
                                                ],
                                            ),
                                            Row(
                                                id: "modules-row-4",
                                                size: (w: Fill, h: Fixed(20.0)),
                                                gap: 4.0,
                                                children: [
                                                    Include(id: "module-net", source: "app-menu/module-cell.kmodule.ron", with: { "label": "NET", "module": "net" }),
                                                    Include(id: "module-buf", source: "app-menu/module-cell.kmodule.ron", with: { "label": "BUF", "module": "buf" }),
                                                    Row(
                                                        id: "modules-filler",
                                                        size: (w: Fill, h: Fixed(20.0)),
                                                        gap: 0.0,
                                                        children: [],
                                                    ),
                                                ],
                                            ),
                                        ],
                                    ),
                                ],
                            ),
                        ),
                        Optional(
                            id: "modules-space-block",
                            hidden: Model(id: "ui.menu.group_hidden", with: { "group": "mod" }),
                            child: Row(
                                id: "modules-space",
                                size: (w: Fill, h: Fixed(8.0)),
                                gap: 0.0,
                                children: [],
                            ),
                        ),
                        Pressable(
                            id: "layouts-head",
                            press: Command(id: "ui.menu.toggle_group", with: { "group": "lay" }),
                            child: Row(
                                size: (w: Fill, h: Fixed(26.0)),
                                pad_x: 10.0,
                                gap: 8.0,
                                frame: (top: true, right: false, bottom: false, left: false),
                                frame_color: LinePop,
                                children: [
                                    Glyph(
                                        id: "layouts-caret",
                                        icon: ChevronRight,
                                        active_icon: ChevronDown,
                                        style: Menu,
                                        color: Muted,
                                        active: Model(id: "ui.menu.group_open", with: { "group": "lay" }),
                                    ),
                                    Text(
                                        id: "layouts-title",
                                        size: (w: Fill, h: Fill),
                                        style: Mono,
                                        color: Text,
                                        label: "Сохранённые раскладки",
                                    ),
                                    Text(
                                        id: "layouts-active",
                                        style: MicroLabel,
                                        color: Accent,
                                        read: Model(id: "ui.layouts.active"),
                                    ),
                                ],
                            ),
                        ),
                        Optional(
                            id: "layouts-block",
                            hidden: Model(id: "ui.menu.group_hidden", with: { "group": "lay" }),
                            child: Column(
                                id: "layouts-list",
                                size: (w: Fill, h: Shrink),
                                gap: 0.0,
                                children: [
                                    Include(id: "layout-1", source: "app-menu/layout-row.kmodule.ron", with: { "label": "КЛУБ · 2 ДЕКИ", "layout": "1" }),
                                    Include(id: "layout-2", source: "app-menu/layout-row.kmodule.ron", with: { "label": "СТУДИЯ · 4 ДЕКИ + VST", "layout": "2" }),
                                    Include(id: "layout-3", source: "app-menu/layout-row.kmodule.ron", with: { "label": "ВИЗУАЛ + ТАЙМЛАЙН", "layout": "3" }),
                                    Include(id: "layout-4", source: "app-menu/layout-row.kmodule.ron", with: { "label": "УЗКОЕ ОКНО · ТАБЫ", "layout": "4" }),
                                    Row(
                                        id: "save",
                                        size: (w: Fill, h: Fixed(24.0)),
                                        pad_x: 10.0,
                                        gap: 8.0,
                                        children: [
                                            Row(id: "save-indent", size: (w: Fixed(9.0), h: Fill), gap: 0.0, children: []),
                                            Glyph(id: "save-icon", icon: Save, style: MenuSmall, color: Muted),
                                            Text(
                                                id: "save-label",
                                                size: (w: Fill, h: Fill),
                                                style: Section,
                                                color: TextDim,
                                                label: "Сохранить раскладку окна…",
                                            ),
                                        ],
                                    ),
                                    Row(
                                        id: "layouts-space",
                                        size: (w: Fill, h: Fixed(6.0)),
                                        gap: 0.0,
                                        children: [],
                                    ),
                                ],
                            ),
                        ),
                        Pressable(
                            id: "full-screen",
                            press: Command(id: "ui.window.toggle_full_screen"),
                            child: Row(
                                size: (w: Fill, h: Fixed(26.0)),
                                pad_x: 10.0,
                                gap: 8.0,
                                frame: (top: true, right: false, bottom: false, left: false),
                                frame_color: LinePop,
                                children: [
                                    Glyph(id: "full-screen-icon", icon: Maximize, style: Menu, color: Muted),
                                    Text(
                                        id: "full-screen-label",
                                        size: (w: Fill, h: Fill),
                                        style: Mono,
                                        label: "Полный экран · активное окно",
                                    ),
                                    Text(id: "full-screen-hint", style: MicroLabel, label: "⌃⌘F"),
                                ],
                            ),
                        ),
                        Include(id: "wave-follow", source: "app-menu/toggle-row.kmodule.ron", with: { "command": "ui.prefs.toggle_wave_follow", "icon": "Activity", "label": "Волна следует за плейхедом", "state": "ui.prefs.wave_follow" }),
                        Row(
                            id: "mixing-label",
                            size: (w: Fill, h: Fixed(22.0)),
                            pad_x: 10.0,
                            gap: 0.0,
                            background: BgFooter,
                            frame: (top: true, right: false, bottom: true, left: false),
                            frame_color: LineInner,
                            children: [
                                Text(
                                    id: "mixing-label-text",
                                    size: (w: Fill, h: Fill),
                                    style: MicroLabel,
                                    label: "СВЕДЕНИЕ",
                                ),
                            ],
                        ),
                        Include(id: "autogain", source: "app-menu/toggle-row.kmodule.ron", with: { "command": "ui.prefs.toggle_autogain", "icon": "SlidersHorizontal", "label": "Автогейн по треку", "state": "ui.prefs.autogain" }),
                        Include(id: "mono", source: "app-menu/toggle-row.kmodule.ron", with: { "command": "ui.prefs.toggle_mono", "icon": "Circle", "label": "Моно-выход", "state": "ui.prefs.mono" }),
                        Row(
                            id: "set-label",
                            size: (w: Fill, h: Fixed(22.0)),
                            pad_x: 10.0,
                            gap: 0.0,
                            background: BgFooter,
                            frame: (top: true, right: false, bottom: true, left: false),
                            frame_color: LineInner,
                            children: [
                                Text(
                                    id: "set-label-text",
                                    size: (w: Fill, h: Fill),
                                    style: MicroLabel,
                                    label: "СЕТ",
                                ),
                            ],
                        ),
                        Include(id: "record", source: "app-menu/hint-row.kmodule.ron", with: { "command": "ui.set.toggle_record", "hint": "ui.set.record_hint", "icon": "Disc", "label": "Запись сета", "state": "ui.set.recording", "tone": "Danger" }),
                        Include(id: "cast", source: "app-menu/hint-row.kmodule.ron", with: { "command": "ui.set.toggle_cast", "hint": "ui.set.cast_hint", "icon": "Radio", "label": "Трансляция", "state": "ui.set.casting", "tone": "Accent" }),
                        Pressable(
                            id: "add-folder",
                            press: Command(id: "ui.library.add_folder"),
                            child: Row(
                                size: (w: Fill, h: Fixed(26.0)),
                                pad_x: 10.0,
                                gap: 8.0,
                                children: [
                                    Glyph(id: "add-folder-icon", icon: FolderPlus, style: Menu, color: Muted),
                                    Text(
                                        id: "add-folder-label",
                                        size: (w: Fill, h: Fill),
                                        style: Mono,
                                        label: "Добавить папку…",
                                    ),
                                    Text(id: "add-folder-hint", style: MicroLabel, label: "⌘O"),
                                ],
                            ),
                        ),
                        Pressable(
                            id: "settings",
                            press: Command(id: "ui.settings.open"),
                            child: Row(
                                size: (w: Fill, h: Fixed(30.0)),
                                pad_x: 10.0,
                                gap: 8.0,
                                background: BgFooter,
                                frame: (top: true, right: false, bottom: false, left: false),
                                frame_color: LinePop,
                                children: [
                                    Glyph(id: "settings-icon", icon: Gear, style: Menu, color: Muted),
                                    Text(
                                        id: "settings-label",
                                        size: (w: Fill, h: Fill),
                                        style: Mono,
                                        color: Text,
                                        label: "Настройки…",
                                    ),
                                    Text(id: "settings-hint", style: MicroLabel, label: "⌘,"),
                                ],
                            ),
                        ),
                    ],
                ),
            ),
        ],
    ),
)
