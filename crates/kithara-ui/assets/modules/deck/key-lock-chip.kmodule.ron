(
    schema: "kithara.module",
    version: 1,
    id: "deck-key-lock-chip",
    chrome: Plain,
    parameters: ["deck"],
    root: Pressable(
        id: "toggle",
        press: Command(id: "deck.key.toggle_lock", with: { "deck": "$deck" }),
        double: Command(id: "deck.key.transpose_reset", with: { "deck": "$deck" }),
        child: Row(
            id: "chip",
            size: (w: Fixed(56.0), h: Fill),
            gap: 3.0,
            active: Telemetry(id: "deck.key.locked", with: { "deck": "$deck" }),
            active_background: FromRead(
                read: Telemetry(id: "deck.key.color", with: { "deck": "$deck" }),
                base: Accent,
            ),
            children: [
                Row(id: "leading", size: (w: Fill, h: Fill), children: []),
                Glyph(
                    id: "icon",
                    icon: Music2,
                    style: MenuSmall,
                    color: FromRead(
                        read: Telemetry(id: "deck.key.color", with: { "deck": "$deck" }),
                        base: Accent,
                    ),
                    active_color: Bg,
                    active: Telemetry(id: "deck.key.locked", with: { "deck": "$deck" }),
                ),
                Optional(
                    id: "key-visible",
                    hidden: Telemetry(id: "deck.key.sounding_hidden", with: { "deck": "$deck" }),
                    child: Text(
                        id: "key",
                        read: Telemetry(id: "deck.key.sounding", with: { "deck": "$deck" }),
                        style: PivotSmall,
                        color: FromRead(
                            read: Telemetry(id: "deck.key.color", with: { "deck": "$deck" }),
                            base: Accent,
                        ),
                        active_color: Bg,
                        active: Telemetry(id: "deck.key.locked", with: { "deck": "$deck" }),
                    ),
                ),
                Optional(
                    id: "readout-visible",
                    hidden: Telemetry(id: "deck.key.transpose_hidden", with: { "deck": "$deck" }),
                    child: Text(
                        id: "readout",
                        read: Telemetry(id: "deck.key.transpose", with: { "deck": "$deck" }),
                        style: MicroLabel,
                        color: Accent,
                        active_color: Bg,
                        active: Telemetry(id: "deck.key.locked", with: { "deck": "$deck" }),
                    ),
                ),
                Row(id: "trailing", size: (w: Fill, h: Fill), children: []),
            ],
        ),
    ),
)
