(
    schema: "kithara.module",
    version: 1,
    id: "deck-key-lock",
    chrome: Plain,
    parameters: ["deck"],
    root: Row(
        size: (w: Shrink, h: Fill),
        gap: 0.0,
        frame: (top: false, right: true, bottom: false, left: false),
        frame_color: LineInner,
        children: [
            Pressable(
                id: "down",
                press: Command(id: "deck.key.transpose_down", with: { "deck": "$deck" }),
                child: Glyph(id: "down-icon", icon: ChevronLeft, style: MenuCell, color: Muted, size: (w: Fixed(15.0), h: Fill)),
            ),
            Include(id: "chip", source: "key-lock-chip.kmodule.ron", with: { "deck": "$deck" }),
            Pressable(
                id: "up",
                press: Command(id: "deck.key.transpose_up", with: { "deck": "$deck" }),
                child: Glyph(id: "up-icon", icon: ChevronRight, style: MenuCell, color: Muted, size: (w: Fixed(15.0), h: Fill)),
            ),
        ],
    ),
)
