(
    schema: "kithara.module",
    version: 1,
    id: "library",
    parameters: ["read", "columns"],
    root: Column(
        children: [
            TrackList(
                id: "tracks",
                read: Model(id: "$read"),
                columns: "$columns",
                adaptive: (priority: Required),
            ),
        ],
    ),
)
