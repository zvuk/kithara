(
    schema: "kithara.module",
    version: 1,
    id: "deck-micro",
    parameters: ["deck"],
    root: Column(
        measure: Height,
        size: (w: Fill, h: Fill),
        children: [
            Include(id: "bar", source: "deck-micro/bar.kmodule.ron", with: { "deck": "$deck" }),
            Reveal(from: 234.0, child: Include(
                id: "deck",
                source: "deck.kmodule.ron",
                with: { "deck": "$deck" },
            )),
            Reveal(from: 494.0, child: Include(id: "library", source: "library.kmodule.ron")),
        ],
    ),
)
