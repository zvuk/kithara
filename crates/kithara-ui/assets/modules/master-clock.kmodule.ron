(
    schema: "kithara.module",
    version: 1,
    id: "master-clock",
    chrome: Plain,
    root: Popover(
        id: "pop",
        open: Model(id: "clock.open"),
        align: End,
        anchor: Row(
            size: (w: Shrink, h: Fill),
            gap: 0.0,
            background: BgPanel,
            active: Model(id: "clock.open"),
            active_background: BgSelect,
            children: [
                Row(
                    id: "beats",
                    size: (w: Fixed(39.0), h: Fill),
                    gap: 3.0,
                    pad_x: 9.0,
                    frame: (top: false, right: true, bottom: false, left: true),
                    frame_color: LineInner,
                    children: [
                        Row(id: "beat-1", size: (w: Fixed(3.0), h: Fixed(11.0)), background: Accent, children: []),
                        Row(id: "beat-2", size: (w: Fixed(3.0), h: Fixed(7.0)), background: LineInner, children: []),
                        Row(id: "beat-3", size: (w: Fixed(3.0), h: Fixed(7.0)), background: LineInner, children: []),
                        Row(id: "beat-4", size: (w: Fixed(3.0), h: Fixed(7.0)), background: LineInner, children: []),
                    ],
                ),
                Column(
                    id: "tempo",
                    size: (w: Fixed(78.0), h: Fill),
                    gap: 2.0,
                    pad_x: 10.0,
                    write: Parameter(id: "clock.tempo"),
                    children: [
                        Text(id: "tempo-label", style: MicroLabel, label: "@clock.tempo_label"),
                        Text(id: "tempo-value", style: Telemetry, read: Model(id: "clock.bpm")),
                    ],
                ),
                Column(
                    id: "nudge",
                    size: (w: Fixed(15.0), h: Fill),
                    gap: 0.0,
                    frame: (top: false, right: false, bottom: false, left: true),
                    frame_color: LineInner,
                    children: [
                        Pressable(
                            id: "up",
                            press: Command(id: "clock.nudge_up"),
                            child: Row(
                                id: "up-cell",
                                size: (w: Fill, h: Fill),
                                gap: 0.0,
                                frame: (top: false, right: false, bottom: true, left: false),
                                frame_color: LineInner,
                                children: [
                                    Text(id: "up-sign", style: Mono, color: Muted, align: Center, label: "+", size: (w: Fill, h: Fill)),
                                ],
                            ),
                        ),
                        Pressable(
                            id: "down",
                            press: Command(id: "clock.nudge_down"),
                            child: Row(
                                id: "down-cell",
                                size: (w: Fill, h: Fill),
                                gap: 0.0,
                                children: [
                                    Text(id: "down-sign", style: Mono, color: Muted, align: Center, label: "−", size: (w: Fill, h: Fill)),
                                ],
                            ),
                        ),
                    ],
                ),
                Pressable(
                    id: "toggle",
                    press: Command(id: "clock.toggle"),
                    child: Row(
                        id: "source-cell",
                        size: (w: Shrink, h: Fill),
                        gap: 5.0,
                        pad_x: 8.0,
                        frame: (top: false, right: false, bottom: false, left: true),
                        frame_color: LineInner,
                        children: [
                            Text(id: "source", style: Mono, color: Accent, read: Model(id: "clock.source")),
                            Glyph(
                                id: "caret",
                                icon: ChevronDown,
                                active_icon: ChevronUp,
                                style: MenuSmall,
                                color: Muted,
                                active: Model(id: "clock.open"),
                            ),
                        ],
                    ),
                ),
            ],
        ),
        content: Include(id: "surface", source: "master-clock/surface.kmodule.ron"),
    ),
)
