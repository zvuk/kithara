(
    schema: "kithara.module",
    version: 1,
    id: "master-clock",
    chrome: Plain,
    root: Popover(
        id: "pop",
        open: Model(id: "clock.open"),
        align: End,
        anchor: Row(
            size: (w: Shrink, h: Fixed(38.0)),
            gap: 0.0,
            background: BgPanel,
            active: Model(id: "clock.open"),
            active_background: BgSelect,
            children: [
                Row(
                    id: "beats",
                    size: (w: Fixed(42.0), h: Fill),
                    gap: 3.0,
                    pad_x: 9.0,
                    frame: (top: false, right: true, bottom: false, left: true),
                    frame_color: LineInner,
                    children: [
                        Row(id: "beat-1", size: (w: Fixed(3.0), h: Fixed(14.0)), background: Accent, children: []),
                        Row(id: "beat-2", size: (w: Fixed(3.0), h: Fixed(9.0)), background: LineInner, children: []),
                        Row(id: "beat-3", size: (w: Fixed(3.0), h: Fixed(9.0)), background: LineInner, children: []),
                        Row(id: "beat-4", size: (w: Fixed(3.0), h: Fixed(9.0)), background: LineInner, children: []),
                    ],
                ),
                Column(
                    id: "tempo",
                    size: (w: Fixed(80.0), h: Fill),
                    gap: 2.0,
                    pad_x: 10.0,
                    write: Parameter(id: "clock.tempo"),
                    children: [
                        Text(id: "tempo-label", style: MicroLabel, label: "@clock.tempo_label"),
                        Text(id: "tempo-value", style: Section, color: Accent, read: Model(id: "clock.bpm")),
                    ],
                ),
                Column(
                    id: "nudge",
                    size: (w: Fixed(15.0), h: Fill),
                    gap: 0.0,
                    frame: (top: false, right: false, bottom: false, left: true),
                    children: [
                        Button(id: "up", label: "+", style: Transport, write: Command(id: "clock.nudge_up"), size: (w: Fill, h: Fixed(18.0))),
                        Button(id: "down", label: "-", style: Transport, write: Command(id: "clock.nudge_down"), size: (w: Fill, h: Fixed(18.0))),
                    ],
                ),
                Pressable(
                    id: "toggle",
                    press: Command(id: "clock.toggle"),
                    child: Row(
                        id: "source-cell",
                        size: (w: Fixed(72.0), h: Fill),
                        gap: 5.0,
                        pad_x: 9.0,
                        frame: (top: false, right: false, bottom: false, left: true),
                        frame_color: LineInner,
                        children: [
                            Text(id: "source", style: Mono, color: Accent, read: Model(id: "clock.source"), size: (w: Fill, h: Fill)),
                            Glyph(id: "caret", icon: ChevronUp, style: MenuSmall, color: Muted),
                        ],
                    ),
                ),
            ],
        ),
        content: Column(
            id: "surface",
            size: (w: Fixed(376.0), h: Shrink),
            gap: 0.0,
            children: [
                Row(
                    id: "header",
                    size: (w: Fill, h: Fixed(26.0)),
                    pad_x: 11.0,
                    frame: (top: false, right: false, bottom: true, left: false),
                    frame_color: LinePop,
                    children: [
                        Text(id: "header-label", style: MicroLabel, label: "@clock.title", size: (w: Fill, h: Fill)),
                        Pressable(id: "close", press: Command(id: "clock.close"), child: Glyph(id: "close-icon", icon: X, style: MenuSmall, color: Muted, size: (w: Fixed(24.0), h: Fill))),
                    ],
                ),
                Row(
                    id: "columns",
                    size: (w: Fill, h: Fixed(20.0)),
                    gap: 7.0,
                    pad_x: 11.0,
                    frame: (top: false, right: false, bottom: true, left: false),
                    frame_color: LinePop,
                    children: [
                        Text(id: "c0", style: MicroLabel, label: "", size: (w: Fixed(14.0), h: Fill)),
                        Text(id: "c1", style: MicroLabel, label: "", size: (w: Fixed(34.0), h: Fill)),
                        Text(id: "c2", style: MicroLabel, label: "@clock.column.tempo", size: (w: Fixed(50.0), h: Fill)),
                        Text(id: "c3", style: MicroLabel, label: "@clock.column.mode", size: (w: Fixed(72.0), h: Fill)),
                        Text(id: "c4", style: MicroLabel, label: "@clock.column.pulse", align: End, size: (w: Fixed(46.0), h: Fill)),
                        Text(id: "c5", style: MicroLabel, label: "@clock.column.stretch", align: End, size: (w: Fill, h: Fill)),
                        Text(id: "c6", style: MicroLabel, label: "", size: (w: Fixed(26.0), h: Fill)),
                    ],
                ),
                Include(id: "source-auto", source: "master-clock/source-row.kmodule.ron", with: { "source": "auto" }),
                Include(id: "source-clock", source: "master-clock/source-row.kmodule.ron", with: { "source": "clock" }),
                Include(id: "source-a", source: "master-clock/source-row.kmodule.ron", with: { "source": "a" }),
                Include(id: "source-b", source: "master-clock/source-row.kmodule.ron", with: { "source": "b" }),
                Include(id: "source-c", source: "master-clock/source-row.kmodule.ron", with: { "source": "c" }),
                Include(id: "source-d", source: "master-clock/source-row.kmodule.ron", with: { "source": "d" }),
                Include(id: "source-link", source: "master-clock/source-row.kmodule.ron", with: { "source": "link" }),
                Include(id: "source-midi", source: "master-clock/source-row.kmodule.ron", with: { "source": "midi" }),
                Row(
                    id: "warning",
                    size: (w: Fill, h: Fixed(24.0)),
                    gap: 6.0,
                    pad_x: 11.0,
                    frame: (top: false, right: false, bottom: true, left: false),
                    frame_color: LinePop,
                    children: [
                        StatusDot(id: "warning-dot", label: "", tone: Success),
                        Text(id: "warning-text", style: MicroLabel, color: Success, read: Model(id: "clock.warning")),
                    ],
                ),
                Row(
                    id: "portals",
                    size: (w: Fill, h: Fixed(34.0)),
                    gap: 6.0,
                    pad_x: 11.0,
                    children: [
                        Text(id: "portals-label", style: MicroLabel, label: "@clock.portals_label", size: (w: Fixed(56.0), h: Fill)),
                        Chip(id: "step", label: "@clock.family.step_label", read: Model(id: "clock.family.step"), write: Command(id: "clock.family.step"), size: (w: Fixed(48.0), h: Fixed(20.0))),
                        Chip(id: "leap", label: "@clock.family.leap_label", read: Model(id: "clock.family.leap"), write: Command(id: "clock.family.leap"), size: (w: Fixed(48.0), h: Fixed(20.0))),
                        Text(id: "limit-label", style: MicroLabel, label: "@clock.limit_label", size: (w: Fixed(18.0), h: Fill)),
                        Scalar(id: "limit", read: Model(id: "clock.limit"), size: (w: Fixed(32.0), h: Fixed(20.0))),
                        Text(id: "tolerance-label", style: MicroLabel, label: "@clock.tolerance_label", size: (w: Fixed(28.0), h: Fill)),
                        Scalar(id: "tolerance", format: Percent, read: Model(id: "clock.tolerance"), size: (w: Fixed(48.0), h: Fixed(20.0))),
                    ],
                ),
                Row(
                    id: "grid",
                    size: (w: Fill, h: Fixed(34.0)),
                    gap: 6.0,
                    pad_x: 11.0,
                    frame: (top: false, right: false, bottom: true, left: false),
                    frame_color: LinePop,
                    children: [
                        Chip(id: "quantize", label: "@clock.grid.quantize_label", read: Model(id: "clock.grid.quantize"), write: Command(id: "clock.grid.toggle_quantize"), size: (w: Fixed(102.0), h: Fixed(22.0))),
                        Readout(id: "division", read: Model(id: "clock.grid.division"), size: (w: Fixed(46.0), h: Fixed(22.0))),
                        Chip(id: "snap", label: "@clock.grid.snap_label", read: Model(id: "clock.grid.snap"), write: Command(id: "clock.grid.toggle_snap"), size: (w: Fixed(106.0), h: Fixed(22.0))),
                        Button(id: "click", label: "", icon: Some(Bell), read: Model(id: "clock.grid.click"), write: Command(id: "clock.grid.toggle_click"), size: (w: Fixed(28.0), h: Fixed(22.0))),
                    ],
                ),
                Row(
                    id: "link-panel",
                    size: (w: Fill, h: Fixed(30.0)),
                    gap: 8.0,
                    pad_x: 11.0,
                    frame: (top: false, right: false, bottom: true, left: false),
                    frame_color: LinePop,
                    children: [
                        StatusDot(id: "link-status", label: "@clock.link.status_label", tone: Accent, size: (w: Fixed(58.0), h: Fill)),
                        Text(id: "link-peers", style: Mono, read: Model(id: "clock.link.peers"), size: (w: Fill, h: Fill)),
                        Chip(id: "link-toggle", label: "@clock.link.toggle_label", read: Model(id: "clock.link.enabled"), write: Command(id: "clock.link.toggle"), size: (w: Fixed(58.0), h: Fixed(20.0))),
                    ],
                ),
                Row(
                    id: "midi-panel",
                    size: (w: Fill, h: Fixed(30.0)),
                    gap: 8.0,
                    pad_x: 11.0,
                    frame: (top: false, right: false, bottom: true, left: false),
                    frame_color: LinePop,
                    children: [
                        StatusDot(id: "midi-status", label: "@clock.midi.status_label", tone: Success, size: (w: Fixed(58.0), h: Fill)),
                        Text(id: "midi-input", style: Mono, read: Model(id: "clock.midi.input"), size: (w: Fixed(72.0), h: Fill)),
                        Text(id: "midi-output", style: MicroLabel, read: Model(id: "clock.midi.output"), size: (w: Fill, h: Fill)),
                        Chip(id: "midi-send", label: "@clock.midi.send_label", read: Model(id: "clock.midi.send"), write: Command(id: "clock.midi.toggle_send"), size: (w: Fixed(58.0), h: Fixed(20.0))),
                    ],
                ),
                Row(
                    id: "tap-row",
                    size: (w: Fill, h: Fixed(28.0)),
                    gap: 0.0,
                    children: [
                        Button(id: "tap", label: "@clock.tap_label", write: Command(id: "clock.tap"), size: (w: Fill, h: Fill)),
                        Button(id: "half", label: "1/2", write: Command(id: "clock.half"), size: (w: Fixed(38.0), h: Fill)),
                        Button(id: "double", label: "x2", write: Command(id: "clock.double"), size: (w: Fixed(38.0), h: Fill)),
                        Button(id: "reset", label: "@clock.reset_label", write: Command(id: "clock.reset"), size: (w: Fixed(56.0), h: Fill)),
                    ],
                ),
            ],
        ),
    ),
)
