(
    schema: "kithara.module",
    version: 1,
    id: "deck-micro-bar",
    parameters: ["deck"],
    root: Row(
        gap: 0.0,
        pad: 0.0,
        measure: Width,
        size: (w: Fill, h: Fixed(44.0)),
        background: BgPanel,
        frame: (top: false, right: false, bottom: true, left: false),
        frame_color: Line,
        children: [
            Include(id: "menu", source: "../app-menu.kmodule.ron"),
            Row(
                id: "play-cell",
                gap: 0.0,
                size: (w: Shrink, h: Fill),
                frame: (top: false, right: false, bottom: false, left: true),
                frame_color: LineInner,
                children: [
                    Button(
                        id: "play",
                        size: (w: Fixed(38.0), h: Fill),
                        label: "@deck.transport.play",
                        active_label: Some("@deck.transport.pause"),
                        style: MicroPrimary,
                        read: Telemetry(id: "deck.playback.playing", with: { "deck": "$deck" }),
                        write: Command(id: "deck.transport.toggle_play", with: { "deck": "$deck" }),
                    ),
                ],
            ),
            Reveal(from: 440.0, child: Row(
                id: "now-cell",
                gap: 0.0,
                size: (w: Shrink, h: Fill),
                frame: (top: false, right: false, bottom: false, left: true),
                frame_color: LineInner,
                children: [
                    DeckSummary(
                        id: "summary",
                        style: Micro,
                        read: Telemetry(id: "deck.track.title", with: { "deck": "$deck" }),
                    ),
                ],
            )),
            Reveal(from: 0.0, until: Some(350.0), child: Row(
                id: "drag-cell",
                gap: 0.0,
                size: (w: Fill, h: Fill),
                frame: (top: false, right: false, bottom: false, left: true),
                frame_color: LineInner,
                children: [
                    WindowDrag(id: "drag", size: (w: Range(min: 36.0, max: None), h: Fill)),
                ],
            )),
            Reveal(from: 350.0, child: Row(
                id: "wave-cell",
                gap: 0.0,
                size: (w: Fill, h: Fill),
                frame: (top: false, right: false, bottom: false, left: true),
                frame_color: LineInner,
                children: [
                    Wave(
                        id: "wave",
                        size: (w: Range(min: 60.0, max: None), h: Fill),
                        style: Micro,
                        read: Telemetry(id: "deck.playback.waveform", with: { "deck": "$deck" }),
                        write: Command(id: "deck.transport.seek_normalized", with: { "deck": "$deck" }),
                    ),
                ],
            )),
            Reveal(from: 520.0, child: Row(
                id: "volume-cell",
                gap: 6.0,
                pad_x: 9.0,
                size: (w: Shrink, h: Fill),
                frame: (top: false, right: false, bottom: false, left: true),
                frame_color: LineInner,
                children: [
                    Glyph(id: "speaker", icon: SpeakerHigh, style: Menu, color: Muted),
                    VuStereo(
                        id: "vu",
                        size: (w: Fixed(64.0), h: Fixed(22.0)),
                        read: Telemetry(id: "player.output.levels"),
                        write: Parameter(id: "player.output.volume"),
                    ),
                ],
            )),
            Reveal(from: 920.0, child: Include(
                id: "stream",
                source: "../deck/quality.kmodule.ron",
                with: { "deck": "$deck" },
            )),
            Reveal(from: 1120.0, child: Row(
                id: "telemetry-cell",
                gap: 12.0,
                pad_x: 12.0,
                size: (w: Shrink, h: Fill),
                frame: (top: false, right: false, bottom: false, left: true),
                frame_color: LineInner,
                children: [
                    Row(
                        id: "cpu",
                        gap: 4.0,
                        size: (w: Shrink, h: Fill),
                        children: [
                            Text(id: "cpu-label", style: Mono, color: Muted, label: "@bar.cpu"),
                            Scalar(
                                id: "cpu-value",
                                size: (w: Shrink, h: Fill),
                                format: Percent,
                                framed: false,
                                read: Telemetry(id: "engine.load"),
                            ),
                        ],
                    ),
                    Row(
                        id: "latency",
                        gap: 4.0,
                        size: (w: Shrink, h: Fill),
                        children: [
                            Text(id: "latency-label", style: Mono, color: Muted, label: "@bar.latency"),
                            Text(
                                id: "latency-value",
                                style: Mono,
                                color: Muted,
                                read: Telemetry(id: "engine.latency"),
                            ),
                        ],
                    ),
                ],
            )),
            Reveal(from: 790.0, child: Include(id: "clock", source: "../master-clock.kmodule.ron")),
            Reveal(from: 670.0, child: Pressable(
                id: "rec",
                press: Command(id: "ui.set.toggle_record"),
                child: Row(
                    id: "rec-cell",
                    gap: 7.0,
                    pad_x: 12.0,
                    size: (w: Shrink, h: Fill),
                    frame: (top: false, right: false, bottom: false, left: true),
                    frame_color: LineInner,
                    children: [
                        StatusDot(
                            id: "rec-dot",
                            label: "@bar.rec",
                            tone: Neutral,
                            size: (w: Shrink, h: Fill),
                            active: Model(id: "ui.set.recording"),
                            active_tone: Danger,
                        ),
                        Text(
                            id: "rec-time",
                            style: Mono,
                            color: Muted,
                            read: Model(id: "ui.set.record_time"),
                        ),
                    ],
                ),
            )),
            Reveal(from: 590.0, child: Row(
                id: "settings-cell",
                gap: 0.0,
                size: (w: Shrink, h: Fill),
                frame: (top: false, right: false, bottom: false, left: true),
                frame_color: LineInner,
                children: [SettingsButton(id: "settings")],
            )),
            Row(
                id: "window-cell",
                gap: 0.0,
                size: (w: Shrink, h: Fill),
                frame: (top: false, right: false, bottom: false, left: true),
                frame_color: LineInner,
                children: [WindowControls(id: "window", style: Standard)],
            ),
        ],
    ),
)
