(
    schema: "kithara.layout",
    version: 1,
    id: "player",
    root: Split(
        axis: Vertical,
        children: [
            (weight: 0.3, node: Module(
                instance: "global-bar",
                source: "modules/global-bar.kmodule.ron",
            )),
            (weight: 2.0, node: Module(
                instance: "deck-a",
                source: "modules/deck.kmodule.ron",
                with: { "deck": "a" },
            )),
            (weight: 2.2, node: Module(
                instance: "library",
                source: "modules/library.kmodule.ron",
                with: {
                    "read": "library.visible_tracks",
                    "columns": "[(id: \"title\", label: \"@track_list.column.title\", style: Primary, width: 180.0, flexible: true), (id: \"artist\", label: \"@track_list.column.artist\", style: Secondary, width: 200.0), (id: \"time\", label: \"@track_list.column.time\", style: Time, width: 70.0)]",
                },
            )),
        ],
    ),
)
