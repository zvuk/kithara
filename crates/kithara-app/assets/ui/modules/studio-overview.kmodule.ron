(
    schema: "kithara.module",
    version: 1,
    id: "studio-overview",
    root: Column(
        gap: 0.0,
        children: [
            Row(
                id: "row-a",
                gap: 0.0,
                frame: (top: false, right: false, bottom: true, left: false),
                children: [
                    Include(
                        id: "a",
                        source: "studio-overview-row.kmodule.ron",
                        with: { "deck": "a", "letter": "A" },
                    ),
                ],
            ),
            Row(
                id: "row-b",
                gap: 0.0,
                frame: (top: false, right: false, bottom: true, left: false),
                children: [
                    Include(
                        id: "b",
                        source: "studio-overview-row.kmodule.ron",
                        with: { "deck": "b", "letter": "B" },
                    ),
                ],
            ),
        ],
    ),
)
