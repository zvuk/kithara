(
    schema: "kithara.module",
    version: 1,
    id: "studio-strip",
    parameters: ["deck", "letter"],
    root: Column(
        gap: 0.0,
        size: (w: Fill, h: Fill),
        children: [
            Column(
                id: "eq",
                gap: 6.0,
                pad: 8.0,
                frame: (top: false, right: false, bottom: true, left: false),
                size: (w: Fill, h: Shrink),
                children: [
                    Row(
                        id: "row-1",
                        gap: 24.0,
                        size: (w: Shrink, h: Shrink),
                        children: [
                            Knob(
                                id: "high",
                                label: Some("HIGH"),
                                read: Parameter(id: "deck.eq.high", with: { "deck": "$deck" }),
                                write: Parameter(id: "deck.eq.high", with: { "deck": "$deck" }),
                            ),
                            Knob(
                                id: "mid",
                                label: Some("MID"),
                                read: Parameter(id: "deck.eq.mid", with: { "deck": "$deck" }),
                                write: Parameter(id: "deck.eq.mid", with: { "deck": "$deck" }),
                            ),
                        ],
                    ),
                    Row(
                        id: "row-2",
                        gap: 24.0,
                        size: (w: Shrink, h: Shrink),
                        children: [
                            Knob(
                                id: "low",
                                label: Some("LOW"),
                                read: Parameter(id: "deck.eq.low", with: { "deck": "$deck" }),
                                write: Parameter(id: "deck.eq.low", with: { "deck": "$deck" }),
                            ),
                            Knob(
                                id: "tempo",
                                label: Some("TEMPO"),
                                read: Parameter(id: "deck.ts.tempo", with: { "deck": "$deck" }),
                                write: Parameter(id: "deck.ts.tempo", with: { "deck": "$deck" }),
                            ),
                        ],
                    ),
                ],
            ),
            Column(
                id: "volume-section",
                pad: 8.0,
                size: (w: Fill, h: Fill),
                children: [
                    Row(
                        id: "volume-row",
                        gap: 9.0,
                        size: (w: Shrink, h: Fill),
                        children: [
                            VuVertical(
                                id: "volume",
                                size: (w: Fixed(38.0), h: Fill),
                                ticks: true,
                                read: Telemetry(id: "mixer.volume", with: { "deck": "$deck" }),
                                write: Parameter(id: "mixer.trim", with: { "deck": "$deck" }),
                            ),
                            Text(
                                id: "channel",
                                size: (w: Fixed(28.0), h: Fill),
                                style: DeckLetter,
                                label: "$letter",
                            ),
                        ],
                    ),
                ],
            ),
        ],
    ),
)
