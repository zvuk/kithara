(
    schema: "kithara.module",
    version: 1,
    id: "studio-mixer-single",
    root: Column(
        size: (w: Fill, h: Fill),
        children: [
            Row(
                id: "strips",
                size: (w: Fill, h: Fill),
                children: [
                    Include(
                        id: "a",
                        source: "studio-strip.kmodule.ron",
                        with: { "deck": "a", "letter": "A" },
                    ),
                ],
            ),
        ],
    ),
)
