(
    schema: "kithara.module",
    version: 1,
    id: "studio-deck",
    parameters: ["deck", "badge"],
    root: Column(
        children: [
            Wave(
                id: "wave",
                style: Hero,
                badge: Some("$badge"),
                read: Telemetry(id: "deck.playback.waveform", with: { "deck": "$deck" }),
                write: Command(id: "deck.transport.seek_normalized", with: { "deck": "$deck" }),
                zoom: Model(id: "deck.view.zoom", with: { "deck": "$deck" }),
                adaptive: (priority: Required),
            ),
            Row(
                id: "transport",
                size: (w: Fill, h: Fixed(36.0)),
                children: [
                    Button(
                        id: "play",
                        size: (w: Fixed(64.0), h: Fill),
                        label: "PLAY",
                        icon: Some(Play),
                        style: TransportPrimary,
                        read: Telemetry(id: "deck.playback.playing", with: { "deck": "$deck" }),
                        write: Command(id: "deck.transport.toggle_play", with: { "deck": "$deck" }),
                        adaptive: (priority: Required),
                    ),
                    Button(
                        id: "prev",
                        size: (w: Fixed(36.0), h: Fill),
                        label: "",
                        icon: Some(Rewind),
                        style: Transport,
                        write: Command(id: "deck.transport.prev", with: { "deck": "$deck" }),
                    ),
                    Button(
                        id: "next",
                        size: (w: Fixed(36.0), h: Fill),
                        label: "",
                        icon: Some(FastForward),
                        style: Transport,
                        write: Command(id: "deck.transport.next", with: { "deck": "$deck" }),
                    ),
                    Spacer(id: "gap"),
                    Time(
                        id: "time",
                        size: (w: Fixed(144.0), h: Fill),
                        read: Telemetry(id: "deck.playback.position_secs", with: { "deck": "$deck" }),
                    ),
                    Chip(
                        id: "keylock",
                        size: (w: Fixed(48.0), h: Fixed(24.0)),
                        label: "KEY",
                        style: Routing,
                        read: Model(id: "deck.ts.keylock", with: { "deck": "$deck" }),
                        write: Command(id: "deck.ts.toggle_keylock", with: { "deck": "$deck" }),
                    ),
                    Readout(
                        id: "tempo",
                        size: (w: Fixed(64.0), h: Fixed(26.0)),
                        label: Some("TEMPO"),
                        tone: Accent,
                        read: Telemetry(id: "deck.playback.tempo", with: { "deck": "$deck" }),
                    ),
                ],
            ),
        ],
    ),
)
