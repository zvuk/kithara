(
    schema: "kithara.module",
    version: 1,
    id: "studio-deck",
    parameters: ["deck", "badge"],
    root: Column(
        children: [
            Wave(
                id: "wave",
                style: Hero,
                badge: Some("$badge"),
                read: Telemetry(id: "deck.playback.waveform", with: { "deck": "$deck" }),
                write: Command(id: "deck.transport.seek_normalized", with: { "deck": "$deck" }),
                zoom: Model(id: "deck.view.zoom", with: { "deck": "$deck" }),
                adaptive: (priority: Required),
            ),
            Row(
                id: "transport",
                size: (w: Fill, h: Fixed(30.0)),
                children: [
                    Button(
                        id: "load",
                        size: (w: Fixed(56.0), h: Fixed(30.0)),
                        label: "LOAD",
                        style: Transport,
                        write: Command(id: "deck.load_selected", with: { "deck": "$deck" }),
                    ),
                    Button(
                        id: "prev",
                        size: (w: Fixed(36.0), h: Fixed(30.0)),
                        label: "",
                        icon: Some(Rewind),
                        style: Transport,
                        write: Command(id: "deck.transport.prev", with: { "deck": "$deck" }),
                    ),
                    Button(
                        id: "play",
                        size: (w: Fixed(64.0), h: Fixed(30.0)),
                        label: "PLAY",
                        icon: Some(Play),
                        style: TransportPrimary,
                        read: Telemetry(id: "deck.playback.playing", with: { "deck": "$deck" }),
                        write: Command(id: "deck.transport.toggle_play", with: { "deck": "$deck" }),
                        adaptive: (priority: Required),
                    ),
                    Button(
                        id: "next",
                        size: (w: Fixed(36.0), h: Fixed(30.0)),
                        label: "",
                        icon: Some(FastForward),
                        style: Transport,
                        write: Command(id: "deck.transport.next", with: { "deck": "$deck" }),
                    ),
                    Time(
                        id: "time",
                        size: (w: Fill, h: Fixed(30.0)),
                        read: Telemetry(id: "deck.playback.position_secs", with: { "deck": "$deck" }),
                    ),
                    Readout(
                        id: "tempo",
                        size: (w: Fixed(110.0), h: Fixed(30.0)),
                        label: Some("TEMPO"),
                        tone: Accent,
                        framed: true,
                        read: Telemetry(id: "deck.playback.tempo", with: { "deck": "$deck" }),
                    ),
                ],
            ),
            Row(
                id: "ts",
                size: (w: Fill, h: Fixed(34.0)),
                children: [
                    Segmented(
                        id: "range",
                        size: (w: Fixed(160.0), h: Fixed(24.0)),
                        items: ["±8", "±16", "±50", "±100"],
                        read: Model(id: "deck.ts.range_index", with: { "deck": "$deck" }),
                    ),
                    Fader(
                        id: "ts-tempo",
                        read: Parameter(id: "deck.ts.tempo", with: { "deck": "$deck" }),
                        write: Parameter(id: "deck.ts.tempo", with: { "deck": "$deck" }),
                    ),
                    Button(
                        id: "reset",
                        size: (w: Fixed(34.0), h: Fixed(28.0)),
                        label: "0",
                        style: Transport,
                        write: Command(id: "deck.ts.reset", with: { "deck": "$deck" }),
                    ),
                    Chip(
                        id: "keylock",
                        size: (w: Fixed(48.0), h: Fixed(24.0)),
                        label: "KEY",
                        style: Routing,
                        read: Model(id: "deck.ts.keylock", with: { "deck": "$deck" }),
                        write: Command(id: "deck.ts.toggle_keylock", with: { "deck": "$deck" }),
                    ),
                    Readout(
                        id: "ratio",
                        size: (w: Fixed(96.0), h: Fixed(28.0)),
                        label: Some("RATIO"),
                        tone: Neutral,
                        framed: true,
                        read: Telemetry(id: "deck.ts.ratio", with: { "deck": "$deck" }),
                    ),
                ],
            ),
            Row(
                id: "eq",
                size: (w: Fill, h: Fixed(46.0)),
                children: [
                    Text(id: "low-label", style: MicroLabel, label: "LOW", size: (w: Fixed(34.0), h: Fixed(14.0))),
                    Knob(
                        id: "low",
                        read: Parameter(id: "deck.eq.low", with: { "deck": "$deck" }),
                        write: Parameter(id: "deck.eq.low", with: { "deck": "$deck" }),
                    ),
                    Text(id: "mid-label", style: MicroLabel, label: "MID", size: (w: Fixed(34.0), h: Fixed(14.0))),
                    Knob(
                        id: "mid",
                        read: Parameter(id: "deck.eq.mid", with: { "deck": "$deck" }),
                        write: Parameter(id: "deck.eq.mid", with: { "deck": "$deck" }),
                    ),
                    Text(id: "high-label", style: MicroLabel, label: "HIGH", size: (w: Fixed(34.0), h: Fixed(14.0))),
                    Knob(
                        id: "high",
                        read: Parameter(id: "deck.eq.high", with: { "deck": "$deck" }),
                        write: Parameter(id: "deck.eq.high", with: { "deck": "$deck" }),
                    ),
                    Spacer(id: "eq-spacer", size: (w: Fill, h: Fixed(38.0))),
                ],
            ),
        ],
    ),
)
