(
    schema: "kithara.module",
    version: 1,
    id: "studio-deck",
    parameters: ["deck", "letter"],
    drop: Some((
        write: Command(id: "deck.queue.load", with: { "deck": "$deck" }),
        read: Model(id: "ui.drag.over", with: { "deck": "$deck" }),
    )),
    root: Column(
        background: BgInset,
        children: [
            Wave(
                id: "wave",
                style: Hero,
                badge: Some("$letter"),
                read: Telemetry(id: "deck.playback.waveform", with: { "deck": "$deck" }),
                write: Command(id: "deck.transport.seek_normalized", with: { "deck": "$deck" }),
                zoom: Model(id: "deck.view.zoom", with: { "deck": "$deck" }),
                adaptive: (priority: Required),
            ),
            Row(
                id: "transport",
                gap: 0.0,
                size: (w: Fill, h: Fixed(38.0)),
                background: BgDeep,
                background_alpha: 0.84,
                children: [
                    Button(
                        id: "play",
                        size: (w: Fixed(68.0), h: Fill),
                        label: "PLAY",
                        icon: Some(Play),
                        style: TransportPrimary,
                        read: Telemetry(id: "deck.playback.playing", with: { "deck": "$deck" }),
                        write: Command(id: "deck.transport.toggle_play", with: { "deck": "$deck" }),
                        adaptive: (priority: Required),
                    ),
                    Button(
                        id: "prev",
                        size: (w: Fixed(40.0), h: Fill),
                        label: "",
                        icon: Some(Rewind),
                        style: Transport,
                        write: Command(id: "deck.transport.prev", with: { "deck": "$deck" }),
                    ),
                    Button(
                        id: "next",
                        size: (w: Fixed(40.0), h: Fill),
                        label: "",
                        icon: Some(FastForward),
                        style: Transport,
                        write: Command(id: "deck.transport.next", with: { "deck": "$deck" }),
                    ),
                    Slot(id: "gap", size: (w: Fill, h: Fill)),
                    Row(
                        id: "tempo",
                        gap: 7.0,
                        pad_x: 11.0,
                        frame: (top: false, right: false, bottom: false, left: true),
                        size: (w: Shrink, h: Fill),
                        children: [
                            Text(id: "tempo-label", style: MicroLabel, label: "TEMPO"),
                            Text(
                                id: "tempo-value",
                                style: Telemetry,
                                read: Telemetry(id: "deck.playback.tempo", with: { "deck": "$deck" }),
                            ),
                        ],
                    ),
                ],
            ),
        ],
    ),
)
