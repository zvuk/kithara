(
    schema: "kithara.module",
    version: 1,
    id: "app-bar-micro",
    parameters: ["deck"],
    root: Row(
        gap: 0.0,
        pad: 0.0,
        measure: Width,
        size: (w: Fill, h: Fixed(42.0)),
        frame: (top: false, right: false, bottom: true, left: false),
        frame_color: Line,
        children: [
            Include(id: "menu", source: "app-menu.kmodule.ron"),
            Button(
                id: "play",
                size: (w: Fixed(68.0), h: Fill),
                label: "@deck.transport.play",
                icon: Some(Play),
                style: TransportPrimary,
                read: Telemetry(id: "deck.playback.playing", with: { "deck": "$deck" }),
                write: Command(id: "deck.transport.toggle_play", with: { "deck": "$deck" }),
            ),
            Reveal(from: 590.0, child: Row(
                id: "now-cell",
                gap: 0.0,
                size: (w: Shrink, h: Fill),
                frame: (top: false, right: false, bottom: false, left: true),
                frame_color: LineInner,
                children: [
                    DeckSummary(
                        id: "summary",
                        size: (w: Fixed(230.0), h: Fill),
                        style: Micro,
                        read: Telemetry(id: "deck.track.title", with: { "deck": "$deck" }),
                    ),
                ],
            )),
            Reveal(from: 0.0, until: Some(350.0), child: WindowDrag(
                id: "drag",
                size: (w: Range(min: 36.0, max: None), h: Fill),
            )),
            Reveal(from: 350.0, child: Wave(
                id: "wave",
                size: (w: Range(min: 60.0, max: None), h: Fill),
                style: Micro,
                read: Telemetry(id: "deck.playback.waveform", with: { "deck": "$deck" }),
                write: Command(id: "deck.transport.seek_normalized", with: { "deck": "$deck" }),
            )),
            Reveal(from: 670.0, child: Row(
                id: "volume-cell",
                gap: 6.0,
                pad_x: 9.0,
                size: (w: Shrink, h: Fill),
                frame: (top: false, right: false, bottom: false, left: true),
                frame_color: LineInner,
                children: [
                    Glyph(id: "speaker", icon: SpeakerHigh, style: Menu, color: Muted),
                    VuStereo(
                        id: "volume",
                        size: (w: Fixed(64.0), h: Fixed(22.0)),
                        read: Telemetry(id: "mixer.volume", with: { "deck": "$deck" }),
                        write: Parameter(id: "mixer.trim", with: { "deck": "$deck" }),
                    ),
                ],
            )),
            Reveal(from: 440.0, child: Row(
                id: "remain-cell",
                size: (w: Fixed(62.0), h: Fill),
                background: BgPanel,
                frame: (top: false, right: false, bottom: false, left: true),
                children: [
                    Text(
                        id: "remain",
                        size: (w: Fill, h: Fill),
                        style: Telemetry,
                        align: Center,
                        read: Telemetry(id: "deck.playback.remain", with: { "deck": "$deck" }),
                    ),
                ],
            )),
            Divider(id: "before-window"),
            WindowControls(id: "window", style: Standard),
        ],
    ),
)
