(
    schema: "kithara.module",
    version: 1,
    id: "app-strip",
    parameters: ["deck", "letter"],
    root: Column(
        gap: 0.0,
        size: (w: Fill, h: Fill),
        children: [
            Popover(
                id: "eq-menu",
                open: Model(id: "deck.eq.menu_open", with: { "deck": "$deck" }),
                at: Pointer,
                anchor: Pressable(
                    id: "eq-menu-anchor",
                    press: Command(id: "deck.eq.menu", with: { "deck": "$deck" }),
                    child: Column(
                        id: "eq",
                        gap: 0.0,
                        frame: (top: false, right: false, bottom: true, left: false),
                        size: (w: Fill, h: Shrink),
                        children: [
                            Adaptive(
                                id: "eq-bands",
                                measure: Read(Model(id: "deck.eq.bands", with: { "deck": "$deck" })),
                                base: Include(
                                    id: "three-band",
                                    source: "app-strip/eq-3-band.kmodule.ron",
                                    with: { "deck": "$deck" },
                                ),
                                steps: [
                                    (from: 4.0, node: Include(
                                        id: "four-band",
                                        source: "app-strip/eq-4-band.kmodule.ron",
                                        with: { "deck": "$deck" },
                                    )),
                                ],
                            ),
                        ],
                    ),
                ),
                content: Column(
                    id: "eq-pop",
                    gap: 0.0,
                    size: (w: Fixed(158.0), h: Shrink),
                    children: [
                        Row(
                            id: "eq-pop-head",
                            size: (w: Fill, h: Fixed(22.0)),
                            pad_x: 10.0,
                            frame: (top: false, right: false, bottom: true, left: false),
                            frame_color: LinePop,
                            children: [
                                Text(id: "eq-pop-title", style: MicroLabel, label: "@strip.eq.title"),
                            ],
                        ),
                        Pressable(
                            id: "eq-3",
                            press: Command(id: "deck.eq.menu", with: { "deck": "$deck" }),
                            child: Include(
                                id: "eq-3-row",
                                source: "app-strip/eq-mode-row.kmodule.ron",
                                with: {
                                    "deck": "$deck",
                                    "label": "@strip.eq.mode.three",
                                    "bands": "3",
                                },
                            ),
                        ),
                        Pressable(
                            id: "eq-4",
                            press: Command(id: "deck.eq.menu", with: { "deck": "$deck" }),
                            child: Include(
                                id: "eq-4-row",
                                source: "app-strip/eq-mode-row.kmodule.ron",
                                with: {
                                    "deck": "$deck",
                                    "label": "@strip.eq.mode.four",
                                    "bands": "4",
                                },
                            ),
                        ),
                    ],
                ),
            ),
            Column(
                id: "volume-section",
                align: Center,
                pad: 8.0,
                size: (w: Fill, h: Fill),
                children: [
                    Row(
                        id: "volume-row",
                        gap: 9.0,
                        size: (w: Shrink, h: Fill),
                        children: [
                            VuVertical(
                                id: "volume",
                                size: (w: Fixed(38.0), h: Fill),
                                ticks: true,
                                read: Telemetry(id: "mixer.volume", with: { "deck": "$deck" }),
                                write: Parameter(id: "mixer.trim", with: { "deck": "$deck" }),
                            ),
                            Text(
                                id: "channel",
                                size: (w: Fixed(28.0), h: Fill),
                                style: DeckLetter,
                                label: "$letter",
                            ),
                        ],
                    ),
                ],
            ),
        ],
    ),
)
