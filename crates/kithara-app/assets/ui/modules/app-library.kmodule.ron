(
    schema: "kithara.module",
    version: 1,
    id: "app-library",
    root: Column(
        children: [
            Table(
                id: "tracks",
                read: Model(id: "library.tracks"),
                columns: [
                    (id: "deck", label: "@track_list.column.deck", style: Badge, width: 64.0),
                    (id: "title", label: "@track_list.column.title", style: Primary, width: 180.0, flexible: true),
                    (id: "artist", label: "@track_list.column.artist", style: Secondary, width: 200.0),
                ],
                adaptive: (priority: Required),
            ),
        ],
    ),
)
