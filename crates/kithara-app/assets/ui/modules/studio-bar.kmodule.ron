(
    schema: "kithara.module",
    version: 1,
    id: "studio-bar",
    root: Row(
        gap: 10.0,
        pad: 7.0,
        children: [
            Brand(id: "brand"),
            Segmented(
                id: "decks",
                size: (w: Fixed(56.0), h: Fixed(22.0)),
                items: ["1", "2"],
                read: Parameter(id: "ui.layout.decks"),
                write: Parameter(id: "ui.layout.decks"),
            ),
            Spacer(id: "spacer"),
        ],
    ),
)
