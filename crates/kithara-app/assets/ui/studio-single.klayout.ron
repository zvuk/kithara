(
    schema: "kithara.layout",
    version: 1,
    id: "studio-single",
    root: Split(
        axis: Vertical,
        children: [
            (node: Module(
                instance: "bar",
                source: "modules/studio-bar.kmodule.ron",
                size: (w: Fill, h: Fixed(36.0)),
            )),
            (node: Module(
                instance: "overview",
                source: "modules/studio-overview-single.kmodule.ron",
                size: (w: Fill, h: Fixed(40.0)),
            )),
            (weight: 2.8, node: Split(
                axis: Horizontal,
                children: [
                    (weight: 1.0, node: Module(
                        instance: "deck-a",
                        source: "modules/studio-deck.kmodule.ron",
                        with: { "deck": "a", "badge": "A" },
                    )),
                    (node: Module(
                        instance: "mixer",
                        source: "modules/studio-mixer.kmodule.ron",
                        size: (w: Fixed(224.0), h: Fill),
                    )),
                ],
            )),
            (weight: 1.3, node: Module(
                instance: "library",
                source: "modules/studio-library.kmodule.ron",
            )),
        ],
    ),
)
