(
    schema: "kithara.layout",
    version: 1,
    id: "app-single",
    resize_edges: true,
    dragged: Some(Model(id: "ui.drag.track")),
    root: Split(
        axis: Vertical,
        measure: Height,
        size: (w: Fill, h: Fill),
        children: [
            (until: Some(450.0), node: Module(
                instance: "micro-bar",
                source: "modules/app-bar-micro.kmodule.ron",
                with: { "deck": "a" },
                size: (w: Fill, h: Fixed(42.0)),
                frame: (top: false, right: false, bottom: false, left: false),
            )),
            (from: 450.0, node: Module(
                instance: "bar",
                source: "modules/app-bar.kmodule.ron",
                size: (w: Fill, h: Fixed(42.0)),
                frame: (top: false, right: false, bottom: true, left: false),
            )),
            (from: 292.0, node: Optional(
                id: "overview-block",
                hidden: Model(id: "ui.module.hidden", with: { "module": "ov" }),
                node: Module(
                    instance: "overview",
                    source: "modules/app-overview-single.kmodule.ron",
                    size: (w: Fill, h: Fixed(40.0)),
                    frame: (top: false, right: false, bottom: true, left: false),
                ),
            )),
            (from: 450.0, weight: 1.3, node: Split(
                axis: Horizontal,
                measure: Width,
                size: (w: Fill, h: Fill),
                children: [
                    (weight: 1.0, node: Module(
                        instance: "deck-a",
                        source: "modules/app-deck.kmodule.ron",
                        with: { "deck": "a", "letter": "A" },
                        frame: (top: false, right: true, bottom: true, left: false),
                    )),
                    (from: 652.0, node: Optional(
                        id: "mixer-block",
                        hidden: Model(id: "ui.module.hidden", with: { "module": "mix" }),
                        node: Module(
                            instance: "mixer",
                            source: "modules/app-mixer-single.kmodule.ron",
                            size: (w: Fixed(224.0), h: Fill),
                            frame: (top: false, right: false, bottom: true, left: false),
                        ),
                    )),
                ],
            )),
            (from: 252.0, weight: 1.3, node: Optional(
                id: "library-block",
                hidden: Model(id: "ui.module.hidden", with: { "module": "lib" }),
                node: Module(
                    instance: "library",
                    source: "modules/app-library.kmodule.ron",
                    frame: (top: false, right: false, bottom: false, left: false),
                ),
            )),
        ],
    ),
)
