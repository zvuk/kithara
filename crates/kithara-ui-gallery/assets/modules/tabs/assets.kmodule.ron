(
    schema: "kithara.module",
    version: 1,
    id: "gallery-assets-tab",
    root: Scroll(
        id: "page",
        size: (w: Fill, h: Fill),
        child: Column(
            gap: Some(16.0),
            pad: Some(24.0),
            children: [
                Text(id: "brand-heading", style: Section, label: "BRAND", size: (w: Fill, h: Fixed(20.0))),
                Row(gap: Some(32.0), size: (w: Fill, h: Fixed(84.0)), children: [
                    Column(gap: Some(8.0), align: Center, size: (w: Fixed(96.0), h: Fill), children: [
                        Glyph(id: "kithara-mark", icon: Kithara, size: (w: Fill, h: Fixed(56.0))),
                        Text(id: "kithara-name", style: MicroLabel, align: Center, label: "KITHARA", size: (w: Fill, h: Fixed(12.0))),
                    ]),
                    Column(gap: Some(8.0), align: Center, size: (w: Fixed(96.0), h: Fill), children: [
                        Glyph(id: "zvuk-mark", icon: Zvuk, size: (w: Fill, h: Fixed(56.0))),
                        Text(id: "zvuk-name", style: MicroLabel, align: Center, label: "ZVUK", size: (w: Fill, h: Fixed(12.0))),
                    ]),
                    Column(gap: Some(6.0), size: (w: Fill, h: Fill), children: [
                        Text(id: "brand-note", style: Body, label: "Both marks are outlines the toolkit draws from the SVG it ships.", size: (w: Fill, h: Fixed(16.0))),
                        Text(id: "brand-path", style: Mono, label: "crates/kithara-ui/assets/icons/", size: (w: Fill, h: Fixed(14.0))),
                    ]),
                ]),
                Text(id: "icons-heading", style: Section, label: "ICONS", size: (w: Fill, h: Fixed(20.0))),
                Text(id: "icons-note", style: Body, label: "Every name a document may write, drawn from the lucide face except the two marks above.", size: (w: Fill, h: Fixed(16.0))),
                Row(gap: Some(8.0), size: (w: Fill, h: Fixed(52.0)), children: [
                    Include(id: "icon-activity", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Activity", "label": "ACTIVITY" }),
                    Include(id: "icon-bell", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Bell", "label": "BELL" }),
                    Include(id: "icon-charts", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Charts", "label": "CHARTS" }),
                    Include(id: "icon-chevron-down", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "ChevronDown", "label": "CHEVRON DOWN" }),
                    Include(id: "icon-chevron-left", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "ChevronLeft", "label": "CHEVRON LEFT" }),
                    Include(id: "icon-chevron-right", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "ChevronRight", "label": "CHEVRON RIGHT" }),
                    Include(id: "icon-chevron-up", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "ChevronUp", "label": "CHEVRON UP" }),
                    Include(id: "icon-chevrons-left", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "ChevronsLeft", "label": "CHEVRONS LEFT" }),
                    Include(id: "icon-chevrons-right", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "ChevronsRight", "label": "CHEVRONS RIGHT" }),
                    Include(id: "icon-circle", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Circle", "label": "CIRCLE" }),
                    Include(id: "icon-clock", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Clock", "label": "CLOCK" }),
                    Include(id: "icon-collection", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Collection", "label": "COLLECTION" }),
                ]),
                Row(gap: Some(8.0), size: (w: Fill, h: Fixed(52.0)), children: [
                    Include(id: "icon-crown", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Crown", "label": "CROWN" }),
                    Include(id: "icon-disc", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Disc", "label": "DISC" }),
                    Include(id: "icon-faders", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Faders", "label": "FADERS" }),
                    Include(id: "icon-fast-forward", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "FastForward", "label": "FAST FORWARD" }),
                    Include(id: "icon-folder", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Folder", "label": "FOLDER" }),
                    Include(id: "icon-folder-plus", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "FolderPlus", "label": "FOLDER PLUS" }),
                    Include(id: "icon-gear", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Gear", "label": "GEAR" }),
                    Include(id: "icon-headphones", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Headphones", "label": "HEADPHONES" }),
                    Include(id: "icon-heart", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Heart", "label": "HEART" }),
                    Include(id: "icon-heart-filled", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "HeartFilled", "label": "HEART FILLED" }),
                    Include(id: "icon-home", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Home", "label": "HOME" }),
                    Include(id: "icon-instrument", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Instrument", "label": "INSTRUMENT" }),
                    Include(id: "icon-kithara", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Kithara", "label": "KITHARA" }),
                ]),
                Row(gap: Some(8.0), size: (w: Fill, h: Fixed(52.0)), children: [
                    Include(id: "icon-lock", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Lock", "label": "LOCK" }),
                    Include(id: "icon-lock-open", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "LockOpen", "label": "LOCK OPEN" }),
                    Include(id: "icon-maximize", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Maximize", "label": "MAXIMIZE" }),
                    Include(id: "icon-menu", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Menu", "label": "MENU" }),
                    Include(id: "icon-monitor", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Monitor", "label": "MONITOR" }),
                    Include(id: "icon-music-2", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Music2", "label": "MUSIC 2" }),
                    Include(id: "icon-music-note", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "MusicNote", "label": "MUSIC NOTE" }),
                    Include(id: "icon-orbit", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Orbit", "label": "ORBIT" }),
                    Include(id: "icon-pause", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Pause", "label": "PAUSE" }),
                    Include(id: "icon-play", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Play", "label": "PLAY" }),
                    Include(id: "icon-play-reverse", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "PlayReverse", "label": "PLAY REVERSE" }),
                    Include(id: "icon-playlist", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Playlist", "label": "PLAYLIST" }),
                ]),
                Row(gap: Some(8.0), size: (w: Fill, h: Fixed(52.0)), children: [
                    Include(id: "icon-playlist-add", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "PlaylistAdd", "label": "PLAYLIST ADD" }),
                    Include(id: "icon-plus", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Plus", "label": "PLUS" }),
                    Include(id: "icon-radio", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Radio", "label": "RADIO" }),
                    Include(id: "icon-refresh-cw", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "RefreshCw", "label": "REFRESH CW" }),
                    Include(id: "icon-repeat", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Repeat", "label": "REPEAT" }),
                    Include(id: "icon-repeat-once", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "RepeatOnce", "label": "REPEAT ONCE" }),
                    Include(id: "icon-rewind", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Rewind", "label": "REWIND" }),
                    Include(id: "icon-save", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Save", "label": "SAVE" }),
                    Include(id: "icon-search", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Search", "label": "SEARCH" }),
                    Include(id: "icon-shuffle", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Shuffle", "label": "SHUFFLE" }),
                    Include(id: "icon-skip-back", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "SkipBack", "label": "SKIP BACK" }),
                ]),
                Row(gap: Some(8.0), size: (w: Fill, h: Fixed(52.0)), children: [
                    Include(id: "icon-skip-forward", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "SkipForward", "label": "SKIP FORWARD" }),
                    Include(id: "icon-sliders-horizontal", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "SlidersHorizontal", "label": "SLIDERS HORIZONTAL" }),
                    Include(id: "icon-speaker-high", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "SpeakerHigh", "label": "SPEAKER HIGH" }),
                    Include(id: "icon-speaker-low", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "SpeakerLow", "label": "SPEAKER LOW" }),
                    Include(id: "icon-speaker-x", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "SpeakerX", "label": "SPEAKER X" }),
                    Include(id: "icon-usb", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Usb", "label": "USB" }),
                    Include(id: "icon-waveform", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Waveform", "label": "WAVEFORM" }),
                    Include(id: "icon-x", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "X", "label": "X" }),
                    Include(id: "icon-zoom-in", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "ZoomIn", "label": "ZOOM IN" }),
                    Include(id: "icon-zoom-out", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "ZoomOut", "label": "ZOOM OUT" }),
                    Include(id: "icon-zvuk", source: "../catalog/icon-cell.kmodule.ron", with: { "icon": "Zvuk", "label": "ZVUK" }),
                ]),
                Text(id: "fonts-heading", style: Section, label: "FONTS", size: (w: Fill, h: Fixed(20.0))),
                Include(id: "face-spacegrotesk-regular", source: "../catalog/font-row.kmodule.ron", with: { "family": "Display", "weight": "Normal", "name": "SPACE GROTESK REGULAR", "file": "SpaceGrotesk-Regular.ttf" }),
                Include(id: "face-spacegrotesk-medium", source: "../catalog/font-row.kmodule.ron", with: { "family": "Display", "weight": "Medium", "name": "SPACE GROTESK MEDIUM", "file": "SpaceGrotesk-Medium.ttf" }),
                Include(id: "face-spacegrotesk-semibold", source: "../catalog/font-row.kmodule.ron", with: { "family": "Display", "weight": "Semibold", "name": "SPACE GROTESK SEMIBOLD", "file": "SpaceGrotesk-SemiBold.ttf" }),
                Include(id: "face-spacegrotesk-bold", source: "../catalog/font-row.kmodule.ron", with: { "family": "Display", "weight": "Bold", "name": "SPACE GROTESK BOLD", "file": "SpaceGrotesk-Bold.ttf" }),
                Include(id: "face-inter-regular", source: "../catalog/font-row.kmodule.ron", with: { "family": "Sans", "weight": "Normal", "name": "INTER REGULAR", "file": "Inter-Regular.ttf" }),
                Include(id: "face-inter-semibold", source: "../catalog/font-row.kmodule.ron", with: { "family": "Sans", "weight": "Semibold", "name": "INTER SEMIBOLD", "file": "Inter-SemiBold.ttf" }),
                Include(id: "face-jetbrainsmono-regular", source: "../catalog/font-row.kmodule.ron", with: { "family": "Mono", "weight": "Normal", "name": "JETBRAINS MONO REGULAR", "file": "JetBrainsMono-Regular.ttf" }),
                Include(id: "face-jetbrainsmono-medium", source: "../catalog/font-row.kmodule.ron", with: { "family": "Mono", "weight": "Medium", "name": "JETBRAINS MONO MEDIUM", "file": "JetBrainsMono-Medium.ttf" }),
                Include(id: "face-jetbrainsmono-semibold", source: "../catalog/font-row.kmodule.ron", with: { "family": "Mono", "weight": "Semibold", "name": "JETBRAINS MONO SEMIBOLD", "file": "JetBrainsMono-SemiBold.ttf" }),
                Text(id: "specimen-heading", style: Section, label: "SPECIMEN", size: (w: Fill, h: Fixed(20.0))),
                Row(gap: Some(12.0), size: (w: Fill, h: Shrink), children: [
                    Include(id: "display", source: "../nav/choice.kmodule.ron", with: { "icon": "Crown", "label": "DISPLAY", "lit": "gallery.font.display", "pick": "gallery.font.select", "choice": "display" }),
                    Include(id: "sans", source: "../nav/choice.kmodule.ron", with: { "icon": "Charts", "label": "SANS", "lit": "gallery.font.sans", "pick": "gallery.font.select", "choice": "sans" }),
                    Include(id: "mono", source: "../nav/choice.kmodule.ron", with: { "icon": "Waveform", "label": "MONO", "lit": "gallery.font.mono", "pick": "gallery.font.select", "choice": "mono" }),
                ]),
                Optional(id: "specimen-display", hidden: Model(id: "gallery.font.display.hidden"), child: Include(id: "display-specimen", source: "../catalog/specimen.kmodule.ron", with: { "family": "Display" })),
                Optional(id: "specimen-sans", hidden: Model(id: "gallery.font.sans.hidden"), child: Include(id: "sans-specimen", source: "../catalog/specimen.kmodule.ron", with: { "family": "Sans" })),
                Optional(id: "specimen-mono", hidden: Model(id: "gallery.font.mono.hidden"), child: Include(id: "mono-specimen", source: "../catalog/specimen.kmodule.ron", with: { "family": "Mono" })),
            ],
        ),
    ),
)
