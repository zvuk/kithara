(
    schema: "kithara.module",
    version: 1,
    id: "gallery-nav",
    root: Column(
        children: [
            Row(
                size: (w: Fill, h: Shrink),
                gap: Some(8.0),
                pad: Some(10.0),
                children: [
                    Glyph(
                        id: "header-icon",
                        icon: Gear,
                        size: (w: Fixed(20.0), h: Fixed(20.0)),
                    ),
                    Text(
                        id: "header-title",
                        style: TrackTitle,
                        label: "GALLERY",
                        size: (w: Fill, h: Fixed(20.0)),
                    ),
                ],
            ),
            Scroll(
                id: "pages",
                size: (w: Fill, h: Fill),
                child: Column(
                    children: [
                    Include(id: "atoms", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "PRIMITIVES", "page": "atoms" }),
                    Include(id: "buttons", source: "nav/item.kmodule.ron", with: { "icon": "Play", "label": "BUTTONS", "page": "buttons" }),
                    Include(id: "faders", source: "nav/item.kmodule.ron", with: { "icon": "Faders", "label": "FADERS", "page": "faders" }),
                    Include(id: "modules", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "MODULES", "page": "modules" }),
                    Include(id: "typography", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "TYPOGRAPHY", "page": "typography" }),
                    Include(id: "assets", source: "nav/item.kmodule.ron", with: { "icon": "Kithara", "label": "ASSETS", "page": "assets" }),
                    Include(id: "cells", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "CELLS", "page": "cells" }),
                    Include(id: "sizes", source: "nav/item.kmodule.ron", with: { "icon": "Faders", "label": "SIZES", "page": "sizes" }),
                    Include(id: "tokens", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "TOKENS", "page": "tokens" }),
                    Include(id: "micro", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "MICRO", "page": "micro" }),
                    Include(id: "mixer", source: "nav/item.kmodule.ron", with: { "icon": "Faders", "label": "MIXER", "page": "mixer" }),
                    Include(id: "vis", source: "nav/item.kmodule.ron", with: { "icon": "Waveform", "label": "VIS", "page": "vis" }),
                    Include(id: "chrome", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "CHROME", "page": "chrome" }),
                    Include(id: "titlebars", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "TITLE BARS", "page": "titlebars" }),
                    Include(id: "table", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "TABLE", "page": "table" }),
                    Include(id: "tree", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "TREE", "page": "tree" }),
                    Include(id: "search", source: "nav/item.kmodule.ron", with: { "icon": "Search", "label": "SEARCH", "page": "search" }),
                    Include(id: "library2", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "LIBRARY V2", "page": "library2" }),
                    Include(id: "stress", source: "nav/item.kmodule.ron", with: { "icon": "SpeakerHigh", "label": "STRESS", "page": "stress" }),
                    Include(id: "menu", source: "nav/item.kmodule.ron", with: { "icon": "Menu", "label": "MENU", "page": "menu" }),
                    Include(id: "modal", source: "nav/item.kmodule.ron", with: { "icon": "Gear", "label": "MODAL", "page": "modal" }),
                    Include(id: "fill", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "FILL", "page": "fill" }),
                    Include(id: "clock", source: "nav/item.kmodule.ron", with: { "icon": "Clock", "label": "CLOCK", "page": "clock" }),
                    Include(id: "pivot", source: "nav/item.kmodule.ron", with: { "icon": "Activity", "label": "PIVOT", "page": "pivot" }),
                    Include(id: "shader", source: "nav/item.kmodule.ron", with: { "icon": "Waveform", "label": "SHADER", "page": "shader" }),
                    Include(id: "objects", source: "nav/item.kmodule.ron", with: { "icon": "Activity", "label": "OBJECTS", "page": "objects" }),
                    Include(id: "motion", source: "nav/item.kmodule.ron", with: { "icon": "Clock", "label": "MOTION", "page": "motion" }),
                    Include(id: "sprites", source: "nav/item.kmodule.ron", with: { "icon": "Orbit", "label": "SPRITES", "page": "sprites" }),
                    Include(id: "lottie", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "LOTTIE", "page": "lottie" }),
                    Include(id: "scene", source: "nav/item.kmodule.ron", with: { "icon": "Orbit", "label": "SCENE", "page": "scene" }),
                    Include(id: "table-long", source: "nav/item.kmodule.ron", with: { "icon": "Playlist", "label": "TABLE (LONG)", "page": "table-long" }),
                    Include(id: "custom", source: "nav/item.kmodule.ron", with: { "icon": "Disc", "label": "CUSTOM", "page": "custom" }),
                    Include(id: "skins", source: "nav/item.kmodule.ron", with: { "icon": "Gear", "label": "SKINS", "page": "skins" }),
                    ],
                ),
            ),
        ],
    ),
)
