(
    schema: "kithara.module",
    version: 1,
    id: "zvuk-page",
    chrome: Plain,
    parameters: ["source"],
    root: Column(
        id: "catalogue",
        children: [
            Optional(
                id: "search-scopes",
                hidden: Model(id: "source.search_controls_hidden", with: { "source": "$source" }),
                child: Row(
                    id: "scopes",
                    size: (w: Fill, h: Fixed(32.0)),
                    frame: (top: false, right: false, bottom: true, left: false),
                    frame_color: LineInner,
                    children: [
                        Pressable(
                            id: "scope-tracks",
                            press: Command(id: "source.scope_tracks", with: { "source": "$source" }),
                            child: Row(
                                size: (w: Shrink, h: Fill),
                                pad_x: 8.0,
                                active: Model(id: "source.scope_tracks", with: { "source": "$source" }),
                                active_background: BgSelect,
                                children: [Text(id: "tracks-label", style: Cell, label: "@zvuk.search.scope.tracks", color: Muted, active_color: Accent, active: Model(id: "source.scope_tracks", with: { "source": "$source" }))],
                            ),
                        ),
                        Pressable(
                            id: "scope-artists",
                            press: Command(id: "source.scope_artists", with: { "source": "$source" }),
                            child: Row(
                                size: (w: Shrink, h: Fill),
                                pad_x: 8.0,
                                active: Model(id: "source.scope_artists", with: { "source": "$source" }),
                                active_background: BgSelect,
                                children: [Text(id: "artists-label", style: Cell, label: "@zvuk.search.scope.artists", color: Muted, active_color: Accent, active: Model(id: "source.scope_artists", with: { "source": "$source" }))],
                            ),
                        ),
                        Pressable(
                            id: "scope-albums",
                            press: Command(id: "source.scope_albums", with: { "source": "$source" }),
                            child: Row(
                                size: (w: Shrink, h: Fill),
                                pad_x: 8.0,
                                active: Model(id: "source.scope_albums", with: { "source": "$source" }),
                                active_background: BgSelect,
                                children: [Text(id: "albums-label", style: Cell, label: "@zvuk.search.scope.albums", color: Muted, active_color: Accent, active: Model(id: "source.scope_albums", with: { "source": "$source" }))],
                            ),
                        ),
                    ],
                ),
            ),
            Row(
                id: "query-bar",
                size: (w: Fill, h: Fixed(32.0)),
                frame: (top: false, right: false, bottom: true, left: false),
                frame_color: LineInner,
                children: [
                    Optional(
                        id: "back-control",
                        hidden: Model(id: "source.back_hidden", with: { "source": "$source" }),
                        child: Pressable(
                            id: "back",
                            press: Command(id: "source.back", with: { "source": "$source" }),
                            child: Row(
                                size: (w: Shrink, h: Fill),
                                pad_x: 8.0,
                                frame: (top: false, right: true, bottom: false, left: false),
                                frame_color: LineInner,
                                children: [Text(id: "back-label", style: Cell, label: "@zvuk.search.back", color: Muted)],
                            ),
                        ),
                    ),
                    Search(id: "query", size: (w: Fill, h: Fill), read: Model(id: "source.query", with: { "source": "$source" }), write: Command(id: "source.query", with: { "source": "$source" })),
                    Row(
                        id: "count-cell",
                        size: (w: Shrink, h: Fill),
                        pad_x: 12.0,
                        frame: (top: false, right: false, bottom: false, left: true),
                        frame_color: LineInner,
                        children: [Text(id: "count", style: Section, read: Model(id: "source.count", with: { "source": "$source" }), color: Muted)],
                    ),
                ],
            ),
            Optional(
                id: "suggestions",
                hidden: Model(id: "source.suggestions_hidden", with: { "source": "$source" }),
                child: Row(
                    id: "suggestion-list",
                    size: (w: Fill, h: Fixed(32.0)),
                    frame: (top: false, right: false, bottom: true, left: false),
                    frame_color: LineInner,
                    children: [
                        Optional(
                            id: "suggestion-0-control",
                            hidden: Model(id: "source.suggestion_0_hidden", with: { "source": "$source" }),
                            child: Pressable(
                                id: "suggestion-0-press",
                                press: Command(id: "source.suggestion_0", with: { "source": "$source" }),
                                child: Row(size: (w: Shrink, h: Fill), pad_x: 8.0, children: [Text(id: "suggestion-0", style: Cell, read: Model(id: "source.suggestion_0", with: { "source": "$source" }), color: Muted)]),
                            ),
                        ),
                        Optional(
                            id: "suggestion-1-control",
                            hidden: Model(id: "source.suggestion_1_hidden", with: { "source": "$source" }),
                            child: Pressable(
                                id: "suggestion-1-press",
                                press: Command(id: "source.suggestion_1", with: { "source": "$source" }),
                                child: Row(size: (w: Shrink, h: Fill), pad_x: 8.0, children: [Text(id: "suggestion-1", style: Cell, read: Model(id: "source.suggestion_1", with: { "source": "$source" }), color: Muted)]),
                            ),
                        ),
                        Optional(
                            id: "suggestion-2-control",
                            hidden: Model(id: "source.suggestion_2_hidden", with: { "source": "$source" }),
                            child: Pressable(
                                id: "suggestion-2-press",
                                press: Command(id: "source.suggestion_2", with: { "source": "$source" }),
                                child: Row(size: (w: Shrink, h: Fill), pad_x: 8.0, children: [Text(id: "suggestion-2", style: Cell, read: Model(id: "source.suggestion_2", with: { "source": "$source" }), color: Muted)]),
                            ),
                        ),
                    ],
                ),
            ),
            Optional(
                id: "status",
                hidden: Model(id: "source.fault_hidden", with: { "source": "$source" }),
                child: Row(
                    id: "status-bar",
                    size: (w: Fill, h: Shrink),
                    pad_x: 34.0,
                    children: [Text(id: "error", read: Model(id: "source.fault", with: { "source": "$source" }), color: Muted)],
                ),
            ),
            Table(
                id: "rows",
                size: (w: Fill, h: Fill),
                footer: false,
                padding_left: 0.0,
                padding_right: 34.0,
                write_width: Parameter(id: "source.column.width", with: { "source": "$source" }),
                status: Model(id: "source.status", with: { "source": "$source" }),
                read: Model(id: "source.rows", with: { "source": "$source" }),
                write: Command(id: "source.select", with: { "source": "$source" }),
                columns: [
                    (id: "reaction", label: "", style: Icon, width: 34.0, write: Command(id: "source.like_track", with: { "source": "$source" })),
                    (id: "open", label: "", style: Icon, width: 34.0, write: Command(id: "source.open_entity", with: { "source": "$source" })),
                    (id: "index", label: "@track_list.column.index", style: Index, width: 28.0),
                    (id: "title", label: "@track_list.column.title", style: Primary, width: 180.0, flexible: true),
                    (id: "artist", label: "@track_list.column.artist", style: Secondary, width: 200.0),
                    (id: "bpm", label: "@track_list.column.bpm", style: Metric, width: 70.0),
                    (id: "key", label: "@track_list.column.key", style: Mono, width: 56.0),
                    (id: "time", label: "@track_list.column.time", style: Time, width: 70.0),
                ],
            ),
            Optional(
                id: "continuation",
                hidden: Model(id: "source.load_more_hidden", with: { "source": "$source" }),
                child: Pressable(
                    id: "load-more",
                    press: Command(id: "source.load_more", with: { "source": "$source" }),
                    child: Row(
                        size: (w: Fill, h: Fixed(32.0)),
                        pad_x: 8.0,
                        frame: (top: true, right: false, bottom: false, left: false),
                        frame_color: LineInner,
                        children: [Text(id: "load-more-label", size: (w: Fill, h: Fill), style: Cell, label: "@zvuk.search.load_more", align: Center, color: Muted)],
                    ),
                ),
            ),
        ],
    ),
)
