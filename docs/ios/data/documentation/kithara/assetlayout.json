{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Kithara\/documentation\/Kithara\/AssetLayout"},"abstract":[{"type":"text","text":"Maps asset sources and resources to paths inside Kithara’s cache."}],"hierarchy":{"paths":[["doc:\/\/Kithara\/documentation\/Kithara"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/kithara\/assetlayout"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"AssetLayout"}],"modules":[{"name":"Kithara"}],"externalID":"s:7Kithara11AssetLayouta","role":"symbol","title":"AssetLayout","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"AssetLayout"}],"roleHeading":"Type Alias","symbolKind":"typealias"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"AssetLayout"},{"kind":"text","text":" = "},{"kind":"typeIdentifier","preciseIdentifier":"s:10KitharaFFI14FfiAssetLayoutP","text":"FfiAssetLayout"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Implementations must be "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", pure, deterministic, fast,"},{"type":"text","text":" "},{"type":"text","text":"non-blocking, and non-throwing. Callbacks may run on background threads."},{"type":"text","text":" "},{"type":"text","text":"Returned paths must not contain query parameters, credentials, or secrets."},{"type":"text","text":" "},{"type":"codeVoice","code":"root"},{"type":"text","text":" is called once whenever a store scope is created. "},{"type":"codeVoice","code":"path"},{"type":"text","text":" is called"},{"type":"text","text":" "},{"type":"text","text":"once whenever a resource key is minted. Cache reads and writes using that"},{"type":"text","text":" "},{"type":"text","text":"key do not invoke either callback again."},{"type":"text","text":" "},{"type":"text","text":"A "},{"type":"codeVoice","code":".url"},{"type":"text","text":" resource contains the full URL. Custom layouts must preserve any"},{"type":"text","text":" "},{"type":"text","text":"required query identity without returning raw query text."},{"type":"text","text":" "},{"type":"codeVoice","code":"root"},{"type":"text","text":" returns exactly one non-empty component and cannot equal "},{"type":"codeVoice","code":"_index"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"path"},{"type":"text","text":" returns a non-empty relative path separated by "},{"type":"codeVoice","code":"\/"},{"type":"text","text":"; no component may"},{"type":"text","text":" "},{"type":"text","text":"end in "},{"code":".tmp","type":"codeVoice"},{"type":"text","text":". Components are ASCII, at most 96 bytes, never "},{"code":".","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":".."},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"do not end in a dot or space, are not Windows device names, and contain"},{"type":"text","text":" "},{"type":"text","text":"neither control bytes nor "},{"type":"codeVoice","code":"< > : \" \/ \\ | ? *"},{"type":"text","text":". These reserved-name checks"},{"type":"text","text":" "},{"type":"text","text":"are case-insensitive. Invalid output fails scope or key creation rather than"},{"type":"text","text":" "},{"type":"text","text":"being rewritten or replaced with the default layout."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Kithara/documentation/Kithara":{"type":"topic","title":"Kithara","abstract":[],"kind":"symbol","url":"\/documentation\/kithara","role":"collection","identifier":"doc:\/\/Kithara\/documentation\/Kithara"},"doc://Kithara/documentation/Kithara/AssetLayout":{"role":"symbol","navigatorTitle":[{"text":"AssetLayout","kind":"identifier"}],"title":"AssetLayout","type":"topic","url":"\/documentation\/kithara\/assetlayout","identifier":"doc:\/\/Kithara\/documentation\/Kithara\/AssetLayout","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AssetLayout"}],"abstract":[{"type":"text","text":"Maps asset sources and resources to paths inside Kithara’s cache."}],"kind":"symbol"}}}